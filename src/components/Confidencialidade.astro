---
import SecaoTitulo from './SecaoTitulo.astro';
import Icone from './Icone.astro';
import { textos, type Idioma } from '../i18n';

interface Props {
  idioma: Idioma;
  id?: string;
}

const { idioma, id = 'titulo-confidencialidade' } = Astro.props;
const t = textos[idioma].confidencialidade;
---

<section class="secao secao--superficie" aria-labelledby={id}>
  <div class="container conf">
    <SecaoTitulo id={id} rotulo={t.rotulo} titulo={t.titulo} lead={t.lead} />
    <ul class="conf__lista" role="list">
      {
        t.compromissos.map((c) => (
          <li>
            <Icone nome="governanca" class="conf__icone" />
            <div>
              <h3>{c.titulo}</h3>
              <p>{c.texto}</p>
            </div>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .conf {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    gap: 24px clamp(32px, 5vw, 72px);
    align-items: start;
  }

  .conf :global(.secao-titulo) {
    margin-bottom: 0;
  }

  .conf__lista {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 16px;
    margin: 0;
  }

  .conf__lista li {
    display: grid;
    grid-template-columns: 24px 1fr;
    gap: 14px;
    padding: 20px;
    border: 1px solid var(--linha);
    border-radius: var(--raio-2);
    background: var(--fundo);
  }

  .conf__lista :global(.conf__icone) {
    width: 22px;
    height: 22px;
    color: var(--acento);
  }

  .conf__lista h3 {
    margin-bottom: 4px;
    font-size: var(--t-base);
  }

  .conf__lista p {
    color: var(--tinta-media);
    font-size: var(--t-sm);
    line-height: 1.5;
  }

  @media (max-width: 960px) {
    .conf {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 560px) {
    .conf__lista {
      grid-template-columns: 1fr;
    }
  }
</style>
