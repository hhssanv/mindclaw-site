---
import SecaoTitulo from './SecaoTitulo.astro';
import type { Estado } from '../lib/schema';

/**
 * Prova em tabela. Na variante "faixas", a segunda coluna é um estado
 * (ok / atencao / alerta) e vira um selo com rótulo em texto, nunca só cor.
 */
interface Props {
  titulo: string;
  lead: string;
  colunas: string[];
  linhas: string[][];
  nota?: string;
  variante?: 'tabela' | 'faixas';
  numero?: number;
}

const { titulo, lead, colunas, linhas, nota, variante = 'tabela', numero } = Astro.props;

const rotuloEstado: Record<Estado, string> = {
  ok: 'Coberto',
  atencao: 'No limite',
  alerta: 'Descoberto',
};
---

<section class="secao" aria-labelledby="titulo-prova">
  <div class="container">
    <SecaoTitulo id="titulo-prova" numero={numero} rotulo="Prova" titulo={titulo} lead={lead} />
    <div class:list={['prova', `prova--${variante}`]}>
      <table role="table">
        <thead role="rowgroup">
          <tr role="row">
            {colunas.map((c) => <th role="columnheader" scope="col">{c}</th>)}
          </tr>
        </thead>
        <tbody role="rowgroup">
          {
            linhas.map((linha) => (
              <tr role="row">
                {linha.map((celula, i) =>
                  i === 0 ? (
                    <th role="rowheader" scope="row" data-rotulo={colunas[i]}>
                      {celula}
                    </th>
                  ) : variante === 'faixas' && i === 1 ? (
                    <td role="cell" data-rotulo={colunas[i]}>
                      <span class:list={['estado', `estado--${celula}`]}>{rotuloEstado[celula as Estado]}</span>
                    </td>
                  ) : (
                    <td role="cell" data-rotulo={colunas[i]}>
                      {celula}
                    </td>
                  ),
                )}
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>
    {nota && <p class="prova__nota">{nota}</p>}
  </div>
</section>

<style>
  .prova {
    border: 1px solid var(--linha);
    border-radius: var(--raio-3);
    overflow: hidden;
  }

  table {
    width: 100%;
    border-collapse: collapse;
    font-size: var(--t-sm);
    line-height: 1.5;
  }

  thead th {
    padding: 14px 20px;
    background: var(--superficie);
    color: var(--tinta-media);
    font-family: var(--fonte-display);
    font-size: 0.75rem;
    font-stretch: 112.5%;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-align: left;
    text-transform: uppercase;
  }

  tbody tr + tr {
    border-top: 1px solid var(--linha);
  }

  tbody th,
  tbody td {
    padding: 18px 20px;
    vertical-align: top;
    text-align: left;
  }

  tbody th {
    width: 22%;
    color: var(--tinta);
    font-weight: 600;
  }

  tbody td {
    color: var(--tinta-media);
  }

  tbody td:last-child {
    color: var(--tinta);
  }

  .prova--tabela tbody td:last-child {
    position: relative;
  }

  .prova__nota {
    display: flex;
    gap: 12px;
    max-width: 62rem;
    margin-top: 20px;
    color: var(--tinta);
    font-size: var(--t-md);
    font-weight: 500;
    line-height: 1.5;
  }

  .prova__nota::before {
    content: '';
    flex: none;
    width: 3px;
    border-radius: 2px;
    background: var(--marca-gradiente);
  }

  @media (max-width: 720px) {
    table,
    thead,
    tbody,
    tr,
    th,
    td {
      display: block;
    }

    thead tr {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip: rect(0 0 0 0);
    }

    tbody tr {
      padding: 16px 18px;
    }

    tbody th,
    tbody td {
      width: auto;
      padding: 0;
    }

    tbody th {
      margin-bottom: 10px;
      font-size: var(--t-md);
    }

    tbody td + td {
      margin-top: 10px;
    }

    tbody td::before {
      content: attr(data-rotulo);
      display: block;
      margin-bottom: 2px;
      color: var(--tinta-fraca);
      font-family: var(--fonte-display);
      font-size: 0.75rem;
      font-stretch: 112.5%;
      font-weight: 600;
      letter-spacing: 0.06em;
      text-transform: uppercase;
    }
  }
</style>
