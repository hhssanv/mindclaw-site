---
import Icone from './Icone.astro';
import { hrefSolucao, type SolucaoEntry } from '../lib/conteudo';
import { textos, type Idioma } from '../i18n';

interface Props {
  idioma: Idioma;
  solucao: SolucaoEntry;
  /** Mostra até três itens de "o que costuma melhorar". */
  ganhos?: boolean;
  nivel?: 2 | 3;
}

const { idioma, solucao, ganhos = false, nivel = 3 } = Astro.props;
const t = textos[idioma].solucaoCard;
const d = solucao.data;
const Titulo = `h${nivel}` as 'h2' | 'h3';
---

<article class="sol">
  <Icone nome={d.icone} class="sol__icone" />
  <Titulo class="sol__titulo">
    <a href={hrefSolucao(idioma, solucao)}>{d.titulo}</a>
  </Titulo>
  <p class="sol__resumo">{d.resumo}</p>
  {
    ganhos && (
      <ul class="sol__ganhos" role="list" aria-label={t.ganhos}>
        {d.ganhos.slice(0, 3).map((g) => (
          <li>
            <Icone nome="check" />
            <span>{g}</span>
          </li>
        ))}
      </ul>
    )
  }
  <span class="link-seta sol__ver" aria-hidden="true">
    {t.ver}
    <Icone nome="seta" />
  </span>
</article>

<style>
  .sol {
    position: relative;
    display: grid;
    grid-template-rows: auto auto 1fr auto auto;
    gap: 10px;
    padding: 26px 24px 24px;
    border: 1px solid var(--linha);
    border-radius: var(--raio-3);
    background: var(--fundo);
    transition: border-color var(--transicao), box-shadow var(--transicao);
    /* A onda (::before) fica atrás do texto, mas na frente do fundo do card. */
    isolation: isolate;
  }

  .sol:hover {
    border-color: var(--linha-forte);
    box-shadow: var(--sombra);
  }

  /* Canto triangular do logo, no canto inferior esquerdo. */
  .sol::after {
    content: '';
    position: absolute;
    left: -1px;
    bottom: -1px;
    width: 24px;
    height: 24px;
    border-bottom-left-radius: var(--raio-3);
    background: linear-gradient(45deg, var(--acento) 50%, transparent 50%);
    opacity: 0;
    transform-origin: 0 100%;
    transition: opacity var(--transicao);
  }

  .sol:hover::after,
  .sol:focus-within::after {
    opacity: 1;
  }

  /* Onda que sai do canto quando a quina aparece, como um pulso. Some sozinha, uma vez só. */
  .sol::before {
    content: '';
    position: absolute;
    left: -1px;
    bottom: -1px;
    z-index: -1;
    width: 160px;
    height: 160px;
    border-bottom-left-radius: var(--raio-3);
    /* Anel que se expande a partir do canto, sobre um brilho suave. */
    background:
      radial-gradient(
        circle at 0 100%,
        transparent 58%,
        color-mix(in srgb, var(--acento) 70%, transparent) 64%,
        transparent 70%
      ),
      radial-gradient(circle at 0 100%, color-mix(in srgb, var(--acento) 30%, transparent), transparent 62%);
    opacity: 0;
    transform-origin: 0 100%;
    pointer-events: none;
  }

  @media (prefers-reduced-motion: no-preference) {
    .sol:hover::after,
    .sol:focus-within::after {
      animation: sol-quina 380ms cubic-bezier(0.34, 1.56, 0.64, 1);
    }

    .sol:hover::before,
    .sol:focus-within::before {
      animation: sol-onda 900ms cubic-bezier(0.2, 0.7, 0.2, 1);
    }
  }

  @keyframes sol-quina {
    from {
      transform: scale(0.2);
    }
  }

  @keyframes sol-onda {
    from {
      opacity: 1;
      transform: scale(0.1);
    }

    to {
      opacity: 0;
      transform: scale(1);
    }
  }

  .sol :global(.sol__icone) {
    width: 28px;
    height: 28px;
    margin-bottom: 6px;
    color: var(--tinta);
  }

  .sol__titulo {
    font-family: var(--fonte-display);
    font-size: var(--t-lg);
    font-weight: 700;
    letter-spacing: -0.01em;
    line-height: 1.2;
  }

  .sol__titulo a {
    text-decoration: none;
  }

  .sol__titulo a::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: var(--raio-3);
  }

  .sol__titulo a:focus-visible {
    outline: none;
  }

  .sol__titulo a:focus-visible::after {
    outline: 2px solid var(--acento);
    outline-offset: 3px;
  }

  .sol__resumo {
    color: var(--tinta-media);
    font-size: var(--t-sm);
    line-height: 1.55;
  }

  .sol__ganhos {
    display: grid;
    gap: 6px;
    margin: 6px 0 4px;
    padding-top: 14px;
    border-top: 1px solid var(--linha);
  }

  .sol__ganhos li {
    display: grid;
    grid-template-columns: 16px 1fr;
    gap: 8px;
    font-size: var(--t-sm);
    font-weight: 500;
    line-height: 1.4;
  }

  .sol__ganhos :global(svg) {
    width: 16px;
    height: 16px;
    margin-top: 2px;
    color: var(--acento);
  }

  .sol__ver {
    margin-top: 6px;
    font-size: var(--t-sm);
  }

  .sol:hover .sol__ver :global(svg) {
    transform: translateX(3px);
  }
</style>
