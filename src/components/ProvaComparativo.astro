---
import SecaoTitulo from './SecaoTitulo.astro';

/** Prova antes/depois. Colunas: [aspecto, antes, depois]. */
interface Props {
  titulo: string;
  lead: string;
  colunas: string[];
  linhas: string[][];
  nota?: string;
  numero?: number;
}

const { titulo, lead, colunas, linhas, nota, numero } = Astro.props;
const [rotuloAspecto, rotuloAntes, rotuloDepois] = colunas;
---

<section class="secao" aria-labelledby="titulo-prova">
  <div class="container">
    <SecaoTitulo id="titulo-prova" numero={numero} rotulo="Prova" titulo={titulo} lead={lead} />
    <div class="comparativo">
      <table role="table">
        <thead role="rowgroup">
          <tr role="row">
            <th role="columnheader" scope="col">{rotuloAspecto}</th>
            <th role="columnheader" scope="col" class="antes">{rotuloAntes}</th>
            <th role="columnheader" scope="col" class="depois">{rotuloDepois}</th>
          </tr>
        </thead>
        <tbody role="rowgroup">
          {
            linhas.map(([aspecto, antes, depois]) => (
              <tr role="row">
                <th role="rowheader" scope="row">
                  {aspecto}
                </th>
                <td role="cell" class="antes" data-rotulo={rotuloAntes}>
                  {antes}
                </td>
                <td role="cell" class="depois" data-rotulo={rotuloDepois}>
                  {depois}
                </td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>
    {nota && <p class="comparativo__nota">{nota}</p>}
  </div>
</section>

<style>
  .comparativo {
    border: 1px solid var(--linha);
    border-radius: var(--raio-3);
    overflow: hidden;
  }

  table {
    width: 100%;
    border-collapse: collapse;
    font-size: var(--t-sm);
    line-height: 1.5;
  }

  thead th {
    padding: 14px 20px;
    background: var(--superficie);
    color: var(--tinta-media);
    font-family: var(--fonte-display);
    font-size: 0.75rem;
    font-stretch: 112.5%;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-align: left;
    text-transform: uppercase;
  }

  thead th.depois {
    color: var(--acento);
  }

  tbody tr + tr {
    border-top: 1px solid var(--linha);
  }

  tbody th,
  tbody td {
    padding: 18px 20px;
    text-align: left;
    vertical-align: top;
  }

  tbody th {
    width: 28%;
    font-weight: 600;
  }

  td.antes {
    color: var(--tinta-fraca);
    text-decoration: line-through;
    text-decoration-color: color-mix(in srgb, var(--tinta-fraca) 50%, transparent);
    text-decoration-thickness: 1px;
  }

  td.depois {
    position: relative;
    background: color-mix(in srgb, var(--superficie-acento) 55%, transparent);
    color: var(--tinta);
    font-weight: 600;
  }

  .comparativo__nota {
    max-width: 62rem;
    margin-top: 18px;
    color: var(--tinta-fraca);
    font-size: var(--t-sm);
  }

  @media (max-width: 720px) {
    table,
    thead,
    tbody,
    tr,
    th,
    td {
      display: block;
    }

    thead tr {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip: rect(0 0 0 0);
    }

    tbody tr {
      padding: 16px 18px;
    }

    tbody th,
    tbody td {
      width: auto;
      padding: 0;
    }

    tbody th {
      margin-bottom: 10px;
      font-size: var(--t-md);
    }

    td.depois {
      margin-top: 8px;
      padding: 8px 10px;
      border-radius: var(--raio-1);
    }

    tbody td::before {
      content: attr(data-rotulo);
      display: block;
      margin-bottom: 2px;
      font-family: var(--fonte-display);
      font-size: 0.75rem;
      font-stretch: 112.5%;
      font-weight: 600;
      font-weight: 500;
      letter-spacing: 0.06em;
      text-decoration: none;
      text-transform: uppercase;
    }

    td.antes::before {
      color: var(--tinta-fraca);
    }

    td.depois::before {
      color: var(--acento);
    }
  }
</style>
