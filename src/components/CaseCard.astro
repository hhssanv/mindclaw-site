---
import TipoBadge from './TipoBadge.astro';
import Icone from './Icone.astro';
import { hrefCase, type CaseEntry } from '../lib/cases';

interface Props {
  case: CaseEntry;
  variante?: 'grade' | 'destaque';
  /** Card largo (ocupa a linha inteira) com as três métricas. */
  largo?: boolean;
  /** Nível do heading do título, conforme a hierarquia da página. */
  nivel?: 2 | 3;
}

const { case: c, variante = 'grade', largo = false, nivel = 3 } = Astro.props;
const { titulo, resumo, tipo, eyebrow, metricas, rascunho } = c.data;
const Titulo = `h${nivel}` as 'h2' | 'h3';
const href = hrefCase(c.id);
const metricasVisiveis = largo ? metricas : metricas.slice(0, 1);
---

<article
  class:list={['card', `card--${variante}`, largo && 'card--largo']}
  data-disciplinas={eyebrow.join('|')}
  data-tipo={tipo}
>
  <div class="card__corpo">
    <div class="card__topo">
      <TipoBadge tipo={tipo} />
      {rascunho && <span class="card__rascunho mono">rascunho</span>}
    </div>
    <Titulo class="card__titulo">
      <a href={href}>{titulo}</a>
    </Titulo>
    <p class="card__resumo">{resumo}</p>
    <ul class="chips card__chips" aria-label="Disciplinas">
      {eyebrow.map((d) => <li class="chip chip--mono">{d}</li>)}
    </ul>
  </div>

  <div class="card__rodape">
    <dl class="card__metricas">
      {
        metricasVisiveis.map((m) => (
          <div class="card__metrica">
            <dt>{m.rotulo}</dt>
            <dd>{m.valor}</dd>
          </div>
        ))
      }
    </dl>
    <span class="link-seta card__ler" aria-hidden="true">
      Ler o case
      <Icone nome="seta" />
    </span>
  </div>
</article>

<style>
  .card {
    position: relative;
    display: grid;
    grid-template-rows: 1fr auto;
    gap: 24px;
    padding: clamp(22px, 2.4vw, 28px);
    border: 1px solid var(--linha);
    border-radius: var(--raio-3);
    background: var(--fundo);
    transition: border-color var(--transicao), box-shadow var(--transicao), transform var(--transicao);
  }

  /* Canto triangular do logo, no canto inferior esquerdo. */
  .card::after {
    content: '';
    position: absolute;
    left: -1px;
    bottom: -1px;
    width: 16px;
    height: 16px;
    border-bottom-left-radius: var(--raio-3);
    background: linear-gradient(45deg, var(--acento) 50%, transparent 50%);
    opacity: 0;
    transition: opacity var(--transicao);
  }

  .card:hover {
    border-color: var(--linha-forte);
    box-shadow: var(--sombra);
  }

  .card:hover::after,
  .card:focus-within::after {
    opacity: 1;
  }

  .card__corpo {
    display: grid;
    align-content: start;
    gap: 12px;
  }

  .card__topo {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .card__rascunho {
    padding: 2px 8px;
    border-radius: 999px;
    background: #fdc04a;
    color: #141414;
    font-size: var(--texto-xs);
  }

  .card__titulo {
    margin-top: 4px;
    font-size: var(--texto-lg);
    font-weight: 700;
    letter-spacing: -0.02em;
    line-height: 1.25;
  }

  .card__titulo a {
    text-decoration: none;
  }

  /* Link esticado: o card inteiro é clicável, mas só o título é o link. */
  .card__titulo a::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: var(--raio-3);
  }

  .card__titulo a:focus-visible {
    outline: none;
  }

  .card__titulo a:focus-visible::after {
    outline: 2px solid var(--acento);
    outline-offset: 3px;
  }

  .card__resumo {
    color: var(--tinta-media);
    font-size: 0.9875rem;
    line-height: 1.55;
  }

  .card__chips {
    margin-top: 4px;
    gap: 6px;
  }

  .card__chips .chip {
    min-height: 26px;
    padding: 3px 9px;
    font-size: 0.6875rem;
  }

  .card__rodape {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: 16px;
    padding-top: 18px;
    border-top: 1px solid var(--linha);
  }

  .card__metricas {
    display: flex;
    flex-wrap: wrap;
    gap: 12px 28px;
  }

  .card__metrica {
    display: flex;
    flex-direction: column-reverse;
    gap: 2px;
  }

  .card__metrica dd {
    margin: 0;
    color: var(--acento);
    font-size: 1.625rem;
    font-weight: 750;
    font-variant-numeric: tabular-nums;
    letter-spacing: -0.03em;
    line-height: 1.1;
  }

  .card__metrica dt {
    max-width: 22ch;
    color: var(--tinta-fraca);
    font-size: var(--texto-sm);
    line-height: 1.35;
  }

  .card__ler {
    font-size: var(--texto-sm);
  }

  .card:hover .card__ler :global(svg) {
    transform: translateX(3px);
  }

  /* Destaque (home) */
  .card--destaque .card__titulo {
    font-size: var(--texto-xl);
  }

  .card--largo {
    grid-template-columns: minmax(0, 1.35fr) minmax(0, 1fr);
    grid-template-rows: none;
    gap: 24px clamp(32px, 5vw, 64px);
    padding: clamp(24px, 3.5vw, 44px);
  }

  .card--largo .card__titulo {
    font-size: var(--texto-2xl);
    max-width: 18ch;
  }

  .card--largo .card__resumo {
    font-size: var(--texto-md);
    max-width: 52ch;
  }

  .card--largo .card__rodape {
    flex-direction: column;
    align-items: stretch;
    justify-content: space-between;
    padding-top: 0;
    padding-left: clamp(24px, 3vw, 40px);
    border-top: 0;
    border-left: 1px solid var(--linha);
  }

  .card--largo .card__metricas {
    flex-direction: column;
    gap: 20px;
  }

  .card--largo .card__metrica dd {
    font-size: clamp(2rem, 1.6rem + 1.4vw, 2.625rem);
  }

  @media (max-width: 860px) {
    .card--largo {
      grid-template-columns: 1fr;
    }

    .card--largo .card__rodape {
      padding-left: 0;
      padding-top: 20px;
      border-left: 0;
      border-top: 1px solid var(--linha);
    }

    .card--largo .card__metricas {
      flex-direction: row;
      gap: 16px 28px;
    }
  }
</style>
