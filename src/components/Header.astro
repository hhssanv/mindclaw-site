---
import Logo from './Logo.astro';
import Icone from './Icone.astro';
import { site, linkWhatsApp, mensagemWhatsApp } from '../lib/site';
import { IDIOMAS, idiomas, linkContato, navegacao, rota, textos, type Alternativas, type Idioma } from '../i18n';

interface Props {
  idioma: Idioma;
  /** Endereço desta página em cada idioma: o seletor de idioma leva para a mesma página. */
  alternativas: Alternativas;
}

const { idioma, alternativas } = Astro.props;
const t = textos[idioma];
const nav = navegacao(idioma);
const contato = linkContato(idioma);
const outrosIdiomas = IDIOMAS.filter((i) => i !== idioma);

const caminho = Astro.url.pathname;
const ativo = (href: string) => caminho === href || caminho.startsWith(href);
---

<header class="topo" data-topo>
  <div class="container topo__interno">
    <a class="topo__marca" href={rota(idioma, 'inicio')} aria-label={t.topo.inicioAria(site.nome)}>
      <Logo id="topo" class="topo__logo" />
    </a>

    <!-- Só aparece no celular com JavaScript; sem ele, a navegação fica visível abaixo do logo. -->
    <button class="topo__menu" type="button" aria-expanded="false" aria-controls="menu-principal" data-menu-botao>
      <span class="topo__menu-icone" aria-hidden="true">
        <Icone nome="menu" class="topo__menu-abrir" />
        <Icone nome="fechar" class="topo__menu-fechar" />
      </span>
      {t.topo.menu}
    </button>

    <!-- No desktop este bloco some do layout (display: contents) e os filhos ocupam as áreas da grade. -->
    <div class="topo__painel" id="menu-principal" data-menu-painel>
      <nav class="topo__nav" aria-label={t.topo.navPrincipal}>
        <ul role="list">
          {
            nav.map((item) => (
              <li>
                <a href={item.href} aria-current={ativo(item.href) ? 'page' : undefined}>
                  {item.rotulo}
                  <Icone nome="seta" class="topo__nav-seta" />
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
      <a class="botao topo__contato" href={contato.href} aria-current={ativo(contato.href) ? 'page' : undefined}>
        {contato.rotulo}
      </a>
      <a class="topo__whatsapp" href={linkWhatsApp(mensagemWhatsApp(idioma))} target="_blank" rel="noopener">
        <Icone nome="conversa" />
        {t.geral.conversarWhatsApp}
        <span class="visualmente-oculto">{t.geral.novaAbaWhatsApp}</span>
      </a>
      <a class="topo__email" href={`mailto:${site.email}`}>{site.email}</a>

      <!-- Idioma e tema. Cada controle mostra para onde leva: "EN" leva ao inglês, a lua ao tema escuro. -->
      <div class="topo__prefs" role="group" aria-label={t.topo.preferencias}>
        {
          outrosIdiomas.map((i) => (
            <a class="pref" href={alternativas[i]} hreflang={i} lang={i} data-idioma={i}>
              <Icone nome="globo" class="pref__globo" />
              <span class="pref__curto" aria-hidden="true">
                {idiomas[i].curto}
              </span>
              <span class="pref__rotulo">{idiomas[i].nome}</span>
            </a>
          ))
        }
        <button
          type="button"
          class="pref pref--tema"
          data-tema-botao
          data-anuncio-escuro={t.topo.temaEscuroAtivado}
          data-anuncio-claro={t.topo.temaClaroAtivado}
        >
          <Icone nome="lua" class="so-no-claro" />
          <Icone nome="sol" class="so-no-escuro" />
          <span class="pref__rotulo so-no-claro">{t.topo.temaEscuro}</span>
          <span class="pref__rotulo so-no-escuro">{t.topo.temaClaro}</span>
        </button>
      </div>
      <p class="visualmente-oculto" aria-live="polite" data-tema-status></p>
    </div>
  </div>
</header>

<script>
  // Tema: o botão alterna entre claro e escuro e guarda a escolha. Se a escolha coincidir com
  // o tema do sistema, ela é apagada e o site volta a acompanhar o sistema. O tema guardado é
  // aplicado antes do primeiro desenho pelo script do <head> (Base.astro).
  type Tema = 'claro' | 'escuro';
  const raiz = document.documentElement;
  const botaoTema = document.querySelector<HTMLButtonElement>('[data-tema-botao]');
  const statusTema = document.querySelector<HTMLElement>('[data-tema-status]');
  const sistemaEscuro = window.matchMedia('(prefers-color-scheme: dark)');
  const coresDaBarra = [...document.querySelectorAll<HTMLMetaElement>('meta[name="theme-color"]')];

  const temaDoSistema = (): Tema => (sistemaEscuro.matches ? 'escuro' : 'claro');
  const temaAtual = (): Tema => (raiz.dataset.tema as Tema | undefined) ?? temaDoSistema();

  // A cor da barra do navegador segue o tema escolhido; sem escolha, cada meta volta à sua cor.
  const corDe = (tema: Tema) => coresDaBarra.find((m) => m.media.includes(tema === 'escuro' ? 'dark' : 'light'))?.dataset.cor;
  const sincronizarBarra = () => {
    const escolhido = raiz.dataset.tema as Tema | undefined;
    for (const meta of coresDaBarra) meta.content = (escolhido && corDe(escolhido)) || meta.dataset.cor || meta.content;
  };

  const aplicarTema = (tema: Tema | null) => {
    // Sem transições durante a troca: a página muda inteira de uma vez.
    raiz.classList.add('trocando-tema');
    if (tema) raiz.dataset.tema = tema;
    else delete raiz.dataset.tema;
    sincronizarBarra();
    void getComputedStyle(raiz).color;
    raiz.classList.remove('trocando-tema');
  };

  botaoTema?.addEventListener('click', () => {
    const novo: Tema = temaAtual() === 'escuro' ? 'claro' : 'escuro';
    const escolha = novo === temaDoSistema() ? null : novo;
    aplicarTema(escolha);
    try {
      if (escolha) localStorage.setItem('tema', escolha);
      else localStorage.removeItem('tema');
    } catch {
      // Armazenamento bloqueado: o tema vale só para esta página.
    }
    if (statusTema) statusTema.textContent = (novo === 'escuro' ? botaoTema.dataset.anuncioEscuro : botaoTema.dataset.anuncioClaro) ?? '';
  });

  // Tema trocado em outra aba do site: esta acompanha.
  window.addEventListener('storage', (e) => {
    if (e.key === 'tema') aplicarTema(e.newValue === 'claro' || e.newValue === 'escuro' ? e.newValue : null);
  });
  sincronizarBarra();

  // Idioma: a escolha feita no seletor vale para as próximas visitas (ver o script do <head> em Base.astro).
  for (const link of document.querySelectorAll<HTMLAnchorElement>('[data-idioma]')) {
    link.addEventListener('click', () => {
      try {
        localStorage.setItem('idioma', link.dataset.idioma ?? '');
      } catch {
        // Sem armazenamento, a escolha vale enquanto a pessoa navega pelo site (ver Base.astro).
      }
    });
  }

  // Menu do celular: botão de abrir e fechar (padrão disclosure), Esc fecha e devolve o foco,
  // o resto da página fica inerte enquanto o menu cobre a tela, e voltar ao desktop fecha.
  const topo = document.querySelector<HTMLElement>('[data-topo]');
  const botao = document.querySelector<HTMLButtonElement>('[data-menu-botao]');
  const painel = document.querySelector<HTMLElement>('[data-menu-painel]');
  const celular = window.matchMedia('(max-width: 720px)');

  if (topo && botao && painel) {
    const fundo = () => [...document.querySelectorAll<HTMLElement>('body > main, body > footer, .pular-link')];

    const definir = (aberto: boolean, devolverFoco = false) => {
      botao.setAttribute('aria-expanded', String(aberto));
      topo.toggleAttribute('data-aberto', aberto);
      document.documentElement.classList.toggle('menu-aberto', aberto);
      for (const el of fundo()) el.inert = aberto;
      if (!aberto && devolverFoco) botao.focus();
    };

    botao.addEventListener('click', () => definir(botao.getAttribute('aria-expanded') !== 'true'));

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && topo.hasAttribute('data-aberto')) definir(false, true);
    });

    // Com o resto da página inerte, o Tab circula dentro do cabeçalho. Se o foco ainda assim
    // sair para outro ponto da página, o menu fecha.
    topo.addEventListener('focusout', (e) => {
      const destino = e.relatedTarget as Node | null;
      if (topo.hasAttribute('data-aberto') && destino && !topo.contains(destino)) definir(false);
    });

    // Link interno clicado: fecha antes de navegar (inclusive âncoras na mesma página).
    painel.addEventListener('click', (e) => {
      if ((e.target as HTMLElement).closest('a')) definir(false);
    });

    celular.addEventListener('change', (e) => {
      if (!e.matches) definir(false);
    });
  }
</script>

<style>
  .topo {
    position: sticky;
    top: 0;
    z-index: 50;
    border-bottom: 1px solid var(--linha);
    background: color-mix(in srgb, var(--fundo) 92%, transparent);
    backdrop-filter: saturate(1.4) blur(10px);
    -webkit-backdrop-filter: saturate(1.4) blur(10px);
  }

  .topo__interno {
    display: grid;
    grid-template-columns: auto 1fr auto auto;
    grid-template-areas: 'marca nav contato prefs';
    align-items: center;
    gap: 8px 24px;
    min-height: 80px;
  }

  .topo__marca {
    grid-area: marca;
    display: block;
    padding-block: 10px;
    color: var(--tinta);
  }

  .topo__marca :global(.topo__logo) {
    display: block;
    width: 168px;
    height: auto;
  }

  .topo__painel {
    display: contents;
  }

  .topo__nav {
    grid-area: nav;
    justify-self: end;
  }

  .topo__nav ul {
    display: flex;
    gap: 4px;
    margin: 0;
  }

  .topo__nav a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding: 8px 14px;
    border-radius: var(--raio-1);
    color: var(--tinta-media);
    font-size: var(--t-sm);
    font-weight: 500;
    text-decoration: none;
    transition: color var(--transicao), background-color var(--transicao);
  }

  .topo__nav a:hover {
    background: var(--superficie);
    color: var(--tinta);
  }

  .topo__nav a[aria-current='page'] {
    color: var(--tinta);
    box-shadow: inset 0 -2px 0 var(--acento);
    border-radius: 0;
  }

  .topo__nav :global(.topo__nav-seta) {
    display: none;
  }

  .topo__contato {
    grid-area: contato;
    min-height: 44px;
    padding: 10px 18px;
    font-size: var(--t-sm);
  }

  .topo__contato[aria-current='page'] {
    box-shadow: 0 0 0 2px var(--fundo), 0 0 0 4px var(--botao);
  }

  .topo__menu,
  .topo__whatsapp,
  .topo__email {
    display: none;
  }

  /* Idioma e tema: botões discretos à direita do Contato. */
  .topo__prefs {
    grid-area: prefs;
    display: flex;
    align-items: center;
    gap: 2px;
    margin-left: -12px;
    margin-right: -10px;
  }

  .pref {
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    min-width: 44px;
    min-height: 44px;
    padding: 8px 10px;
    border: 0;
    border-radius: var(--raio-1);
    background: transparent;
    color: var(--tinta-media);
    font-family: var(--fonte-display);
    font-size: var(--t-sm);
    font-stretch: 112.5%;
    font-weight: 600;
    letter-spacing: 0.08em;
    line-height: 1;
    text-decoration: none;
    cursor: pointer;
    transition: color var(--transicao), background-color var(--transicao);
  }

  .pref:hover {
    background: var(--superficie);
    color: var(--tinta);
  }

  .pref :global(svg) {
    flex: none;
    width: 20px;
    height: 20px;
  }

  /* No desktop o nome completo fica só para leitores de tela; o globo só aparece no menu do celular. */
  .pref__rotulo {
    position: absolute;
    width: 1px;
    height: 1px;
    margin: -1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
  }

  .topo__prefs :global(.pref__globo) {
    display: none;
  }

  /* O tema depende de JavaScript; sem ele, vale o do sistema e o botão não aparece. */
  .pref--tema {
    display: none;
  }

  :global(.js) .pref--tema {
    display: inline-flex;
  }

  @media (max-width: 1023px) {
    .topo__marca :global(.topo__logo) {
      width: 144px;
    }

    .topo__interno {
      column-gap: 16px;
    }

    .topo__nav a {
      padding-inline: 10px;
    }

    .topo__contato {
      padding-inline: 14px;
    }

    .topo__prefs {
      margin-left: -6px;
    }
  }

  /* Celular sem JavaScript: navegação em uma segunda linha, sempre visível. */
  @media (max-width: 720px) {
    .topo__interno {
      grid-template-columns: 1fr auto;
      grid-template-areas:
        'marca contato'
        'nav prefs';
      gap: 0 16px;
      min-height: 64px;
    }

    .topo__prefs {
      margin: 0 -10px 0 0;
      border-top: 1px solid var(--linha);
    }

    .topo__marca :global(.topo__logo) {
      width: 120px;
    }

    .topo__nav {
      justify-self: stretch;
      margin-inline: -8px;
      border-top: 1px solid var(--linha);
    }

    .topo__nav ul {
      justify-content: space-between;
    }

    .topo__nav a {
      padding-inline: 8px;
    }
  }

  /* Celular com JavaScript: botão Menu e painel que cobre a tela abaixo do cabeçalho. */
  @media (max-width: 720px) {
    :global(.js) .topo__interno {
      grid-template-areas: 'marca menu';
    }

    :global(.js) .topo[data-aberto] .topo__prefs {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 8px;
      margin: 4px 0 0;
      padding-top: 16px;
      border-top: 1px solid var(--linha);
    }

    :global(.js) .topo[data-aberto] .pref {
      justify-content: center;
      min-height: 52px;
      border: 1px solid var(--linha-forte);
      color: var(--tinta);
      font-family: var(--fonte);
      font-size: var(--t-sm);
      font-stretch: 100%;
      letter-spacing: 0;
    }

    :global(.js) .topo[data-aberto] .pref__curto {
      display: none;
    }

    :global(.js) .topo[data-aberto] .pref__rotulo {
      position: static;
      width: auto;
      height: auto;
      margin: 0;
      overflow: visible;
      clip: auto;
    }

    :global(.js) .topo[data-aberto] .topo__prefs :global(.pref__globo) {
      display: block;
    }

    :global(.js) .topo__menu {
      grid-area: menu;
      display: inline-flex;
      align-items: center;
      gap: 8px;
      min-height: 44px;
      margin-right: -10px;
      padding: 8px 10px;
      border: 0;
      border-radius: var(--raio-1);
      background: transparent;
      color: var(--tinta);
      font-family: var(--fonte-display);
      font-size: var(--t-sm);
      font-stretch: 112.5%;
      font-weight: 600;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      cursor: pointer;
    }

    .topo__menu-icone {
      display: grid;
    }

    .topo__menu-icone :global(svg) {
      grid-area: 1 / 1;
      width: 24px;
      height: 24px;
      transition: opacity var(--transicao), transform var(--transicao);
    }

    .topo__menu-icone :global(.topo__menu-fechar),
    .topo[data-aberto] .topo__menu-icone :global(.topo__menu-abrir) {
      opacity: 0;
      transform: rotate(-45deg);
    }

    .topo[data-aberto] .topo__menu-icone :global(.topo__menu-fechar) {
      opacity: 1;
      transform: none;
    }

    :global(.js) .topo__painel {
      display: none;
    }

    :global(.js) .topo[data-aberto] .topo__painel {
      position: absolute;
      top: 100%;
      right: 0;
      left: 0;
      display: flex;
      flex-direction: column;
      gap: 12px;
      /* Altura da tela inteira: o que passa da borda fica abaixo do fim da página, nunca à mostra. */
      height: 100dvh;
      padding: 8px var(--gutter) calc(88px + env(safe-area-inset-bottom));
      overflow-y: auto;
      border-top: 1px solid var(--linha);
      background: var(--fundo);
    }

    :global(.js) .topo[data-aberto] .topo__nav {
      margin: 0 0 12px;
      border: 0;
    }

    :global(.js) .topo[data-aberto] .topo__nav ul {
      flex-direction: column;
      gap: 0;
    }

    :global(.js) .topo[data-aberto] .topo__nav a {
      display: flex;
      justify-content: space-between;
      min-height: 60px;
      padding: 12px 2px;
      border-bottom: 1px solid var(--linha);
      border-radius: 0;
      color: var(--tinta);
      font-family: var(--fonte-display);
      font-size: var(--t-xl);
      font-weight: 700;
    }

    :global(.js) .topo[data-aberto] .topo__nav a:hover {
      background: transparent;
      color: var(--acento);
    }

    :global(.js) .topo[data-aberto] .topo__nav a[aria-current='page'] {
      box-shadow: inset 3px 0 0 var(--acento);
      padding-left: 14px;
    }

    :global(.js) .topo[data-aberto] .topo__nav :global(.topo__nav-seta) {
      display: block;
      width: 22px;
      height: 22px;
      color: var(--tinta-fraca);
    }

    :global(.js) .topo[data-aberto] .topo__contato {
      justify-content: center;
      min-height: 52px;
      font-size: var(--t-base);
    }

    :global(.js) .topo[data-aberto] .topo__whatsapp {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 10px;
      min-height: 52px;
      border: 1px solid var(--linha-forte);
      border-radius: var(--raio-1);
      color: var(--tinta);
      font-weight: 600;
      text-decoration: none;
    }

    :global(.js) .topo[data-aberto] .topo__email {
      display: block;
      align-self: center;
      margin-top: 4px;
      padding: 10px;
      color: var(--tinta-media);
      font-size: var(--t-sm);
    }

    .topo__whatsapp :global(svg) {
      width: 20px;
      height: 20px;
      color: var(--acento);
    }

    @media (prefers-reduced-motion: no-preference) {
      :global(.js) .topo[data-aberto] .topo__painel {
        animation: menu-entra 220ms cubic-bezier(0.2, 0.7, 0.2, 1);
      }
    }
  }

  @keyframes menu-entra {
    from {
      opacity: 0;
      transform: translateY(-8px);
    }
  }

  :global(html.menu-aberto) {
    overflow: hidden;
  }
</style>
