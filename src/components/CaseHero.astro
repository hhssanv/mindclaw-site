---
import TipoBadge from './TipoBadge.astro';
import type { Case } from '../lib/schema';

interface Props {
  eyebrow: Case['eyebrow'];
  titulo: string;
  subtitulo: string;
  tipo: Case['tipo'];
  capacidades: Case['capacidades'];
  metricas: Case['metricas'];
  rascunho?: boolean;
}

const { eyebrow, titulo, subtitulo, tipo, capacidades, metricas, rascunho } = Astro.props;
---

<section class="hero faixa" aria-labelledby="titulo-case">
  <div class="container hero__interno entrada">
    <div class="hero__topo">
      <TipoBadge tipo={tipo} completo />
      {rascunho && <span class="hero__rascunho">Rascunho · não publicado</span>}
    </div>
    <p class="eyebrow eyebrow--acento hero__eyebrow">
      {
        eyebrow.map((item, i) => (
          <>
            {i > 0 && <span aria-hidden="true">·</span>}
            <span>{item}</span>
          </>
        ))
      }
    </p>
    <h1 id="titulo-case">{titulo}</h1>
    <p class="hero__subtitulo">{subtitulo}</p>
    <ul class="chips hero__chips" aria-label="Capacidades demonstradas">
      {capacidades.map((c) => <li class="chip">{c}</li>)}
    </ul>
    <dl class="hero__metricas">
      {
        metricas.map((m) => (
          <div class="metrica">
            <dt>{m.rotulo}</dt>
            <dd>{m.valor}</dd>
          </div>
        ))
      }
    </dl>
  </div>
  <span class="hero__traco traco" aria-hidden="true"></span>
</section>

<style>
  .hero {
    position: relative;
    overflow: hidden;
    padding-block: clamp(36px, 5vw, 64px) clamp(32px, 4vw, 48px);
  }

  .hero__traco {
    position: absolute;
    left: 0;
    bottom: 0;
    width: 100%;
    height: 3px;
    border-radius: 0;
    opacity: 0.9;
  }

  @media (prefers-reduced-motion: no-preference) {
    .hero__traco {
      animation: traco 1100ms 200ms cubic-bezier(0.6, 0, 0.2, 1) both;
    }
  }

  .hero__interno {
    display: grid;
    gap: 18px;
  }

  .hero__topo {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 10px;
  }

  .hero__rascunho {
    padding: 4px 10px;
    border-radius: 999px;
    background: #fdc04a;
    color: #141414;
    font-family: var(--fonte-mono);
    font-size: var(--texto-xs);
    font-weight: 500;
    text-transform: uppercase;
  }

  .hero__eyebrow {
    display: flex;
    flex-wrap: wrap;
    gap: 4px 10px;
    margin-top: 6px;
  }

  h1 {
    max-width: 21ch;
  }

  .hero__subtitulo {
    max-width: 62ch;
    color: var(--tinta-media);
    font-size: var(--texto-lg);
    line-height: 1.55;
  }

  .hero__chips {
    margin-top: 2px;
  }

  .hero__chips .chip {
    border-color: var(--linha-forte);
    color: var(--tinta);
  }

  .hero__metricas {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    margin-top: clamp(12px, 2vw, 20px);
    border-top: 1px solid var(--linha);
  }

  .metrica {
    display: flex;
    flex-direction: column-reverse;
    justify-content: flex-end;
    gap: 6px;
    padding: 20px 24px 4px 0;
  }

  .metrica + .metrica {
    padding-left: 24px;
    border-left: 1px solid var(--linha);
  }

  .metrica dd {
    margin: 0;
    color: var(--acento);
    font-size: clamp(2rem, 1.5rem + 2vw, 2.875rem);
    font-weight: 750;
    font-variant-numeric: tabular-nums;
    letter-spacing: -0.03em;
    line-height: 1;
  }

  .metrica dt {
    max-width: 22ch;
    color: var(--tinta-media);
    font-size: var(--texto-sm);
    line-height: 1.45;
  }

  @media (max-width: 640px) {
    .hero__metricas {
      grid-template-columns: 1fr;
    }

    .metrica,
    .metrica + .metrica {
      flex-direction: row-reverse;
      justify-content: flex-end;
      align-items: baseline;
      gap: 14px;
      padding: 14px 0;
      border-left: 0;
    }

    .metrica + .metrica {
      border-top: 1px solid var(--linha);
    }

    .metrica dd {
      flex: none;
      min-width: 3.2ch;
      font-size: 1.875rem;
    }
  }
</style>
