---
import TipoBadge from './TipoBadge.astro';
import Icone from './Icone.astro';
import type { Case } from '../lib/schema';

interface Props {
  eyebrow: Case['eyebrow'];
  titulo: string;
  subtitulo: string;
  tipo: Case['tipo'];
  capacidades: Case['capacidades'];
  metricas: Case['metricas'];
  rascunho?: boolean;
}

const { eyebrow, titulo, subtitulo, tipo, capacidades, metricas, rascunho } = Astro.props;
---

<section class="hero faixa" aria-labelledby="titulo-case">
  <div class="container hero__interno entrada">
    <div class="hero__texto">
      <div class="hero__topo">
        <TipoBadge tipo={tipo} completo />
        {rascunho && <span class="hero__rascunho">Rascunho · não publicado</span>}
      </div>
      <p class="eyebrow eyebrow--acento hero__eyebrow">
        {
          eyebrow.map((item, i) => (
            <>
              {i > 0 && <span aria-hidden="true">·</span>}
              <span>{item}</span>
            </>
          ))
        }
      </p>
      <h1 id="titulo-case">{titulo}</h1>
      <p class="hero__subtitulo">{subtitulo}</p>
    </div>

    <div class="hero__capacidades">
      <p class="eyebrow">Capacidades demonstradas</p>
      <ul role="list">
        {
          capacidades.map((c) => (
            <li>
              <Icone nome="check" />
              <span>{c}</span>
            </li>
          ))
        }
      </ul>
    </div>

    <dl class="hero__metricas">
      {
        metricas.map((m) => (
          <div class="metrica">
            <dt>{m.rotulo}</dt>
            <dd class="numeral">{m.valor}</dd>
          </div>
        ))
      }
    </dl>
  </div>
  <span class="hero__traco traco" aria-hidden="true"></span>
</section>

<style>
  .hero {
    position: relative;
    overflow: hidden;
    padding-block: clamp(40px, 5vw, 72px) clamp(32px, 4vw, 48px);
  }

  .hero__traco {
    position: absolute;
    left: 0;
    bottom: 0;
    width: 100%;
    height: 3px;
    border-radius: 0;
  }

  @media (prefers-reduced-motion: no-preference) {
    .hero__traco {
      animation: traco 1100ms 200ms cubic-bezier(0.6, 0, 0.2, 1) both;
    }
  }

  .hero__interno {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(260px, 340px);
    grid-template-areas:
      'texto capacidades'
      'metricas metricas';
    gap: 32px clamp(32px, 6vw, 96px);
    align-items: end;
  }

  .hero__texto {
    grid-area: texto;
    display: grid;
    gap: 18px;
  }

  .hero__topo {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 10px;
  }

  .hero__rascunho {
    padding: 4px 10px;
    border-radius: 999px;
    background: #fdc04a;
    color: #141414;
    font-family: var(--fonte-display);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .hero__eyebrow {
    display: flex;
    flex-wrap: wrap;
    gap: 4px 10px;
    margin-top: 6px;
  }

  h1 {
    max-width: 18ch;
  }

  .hero__subtitulo {
    max-width: 58ch;
    color: var(--tinta-media);
    font-size: var(--t-lg);
    line-height: 1.55;
  }

  .hero__capacidades {
    grid-area: capacidades;
    display: grid;
    gap: 14px;
    padding: 22px 24px;
    border: 1px solid var(--linha);
    border-radius: var(--raio-3);
    background: var(--faixa-elevada);
  }

  .hero__capacidades ul {
    display: grid;
    gap: 10px;
    margin: 0;
  }

  .hero__capacidades li {
    display: grid;
    grid-template-columns: 18px 1fr;
    gap: 10px;
    color: var(--tinta);
    font-size: var(--t-sm);
    font-weight: 500;
    line-height: 1.4;
  }

  .hero__capacidades :global(svg) {
    width: 18px;
    height: 18px;
    margin-top: 1px;
    color: var(--acento);
  }

  .hero__metricas {
    grid-area: metricas;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    margin-top: 8px;
    border-top: 1px solid var(--linha);
  }

  .metrica {
    display: flex;
    flex-direction: column-reverse;
    justify-content: flex-end;
    gap: 8px;
    padding: 22px 24px 4px 0;
  }

  .metrica + .metrica {
    padding-left: 28px;
    border-left: 1px solid var(--linha);
  }

  .metrica dd {
    margin: 0;
    color: var(--acento);
    font-size: var(--t-numero);
    font-weight: 700;
    letter-spacing: -0.01em;
    line-height: 1;
  }

  .metrica dt {
    max-width: 24ch;
    color: var(--tinta-media);
    font-size: var(--t-sm);
    line-height: 1.45;
  }

  @media (max-width: 900px) {
    .hero__interno {
      grid-template-columns: 1fr;
      grid-template-areas:
        'texto'
        'capacidades'
        'metricas';
      align-items: start;
    }
  }

  @media (max-width: 640px) {
    .hero__metricas {
      grid-template-columns: 1fr;
    }

    .metrica,
    .metrica + .metrica {
      flex-direction: row-reverse;
      justify-content: flex-end;
      align-items: baseline;
      gap: 14px;
      padding: 14px 0;
      border-left: 0;
    }

    .metrica + .metrica {
      border-top: 1px solid var(--linha);
    }

    .metrica dd {
      flex: none;
      min-width: 3.4ch;
      font-size: 2rem;
    }
  }
</style>
