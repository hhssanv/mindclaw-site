---
/**
 * Wordmark "<Hans> MINDCLAW" em SVG inline.
 * A parte em tinta usa currentColor, então o mesmo logo funciona em fundo claro
 * e escuro (como as versões positiva e negativa do Drive). O degradê é o original.
 */
interface Props {
  /** Sufixo único para o id do degradê (header, rodapé etc.). */
  id: string;
  class?: string;
}

const { id, class: classe } = Astro.props;
const gradiente = `logo-degrade-${id}`;
