---
import Logo from './Logo.astro';
import Icone from './Icone.astro';
import { site, linkWhatsApp } from '../lib/site';
import { solucoes, hrefSolucao } from '../lib/conteudo';
import { linkContato, navegacao, rota, textos, type Idioma } from '../i18n';

interface Props {
  idioma: Idioma;
}

const { idioma } = Astro.props;
const t = textos[idioma];
const areas = await solucoes(idioma);
const ano = new Date().getFullYear();

const mapa = [
  { rotulo: t.navegacao.inicio, href: rota(idioma, 'inicio') },
  ...navegacao(idioma),
  linkContato(idioma),
  { rotulo: t.navegacao.privacidade, href: rota(idioma, 'privacidade') },
];
---

<footer class="rodape faixa">
  <div class="container">
    <div class="rodape__topo">
      <a class="rodape__marca" href={rota(idioma, 'inicio')} aria-label={t.topo.inicioAria(site.nome)}>
        <Logo id="rodape" class="rodape__logo" />
      </a>
      <p class="rodape__posicionamento">{t.site.posicionamento}</p>
    </div>

    <div class="rodape__colunas">
      <nav class="rodape__mapa" aria-label={t.rodape.mapa}>
        <h2 class="eyebrow">{t.rodape.mapa}</h2>
        <ul role="list">
          {
            mapa.map((item) => (
              <li>
                <a href={item.href}>{item.rotulo}</a>
              </li>
            ))
          }
        </ul>
      </nav>

      <nav aria-label={t.rodape.solucoes}>
        <h2 class="eyebrow">{t.rodape.solucoes}</h2>
        <ul role="list">
          {
            areas.map((a) => (
              <li>
                <a href={hrefSolucao(idioma, a)}>{a.data.titulo}</a>
              </li>
            ))
          }
        </ul>
      </nav>

      <div>
        <h2 class="eyebrow">{t.rodape.contato}</h2>
        <ul role="list" class="rodape__canais">
          <li>
            <a href={`mailto:${site.email}`}>
              <Icone nome="email" />
              {site.email}
            </a>
          </li>
          <li>
            <a href={linkWhatsApp()} rel="noopener">
              <Icone nome="whatsapp" />
              WhatsApp {site.whatsapp.exibicao}
            </a>
          </li>
        </ul>
      </div>

      <div class="rodape__nota">
        <h2 class="eyebrow">{t.rodape.confidencialidade}</h2>
        <p>{t.site.confidencialidade}</p>
      </div>
    </div>

    <p class="rodape__base">
      <span>© {ano} {site.pessoa} · {site.nome}</span>
      <span class="numeral">hansmindclaw.com</span>
    </p>
  </div>
</footer>

<style>
  .rodape {
    padding-block: clamp(48px, 6vw, 80px) 28px;
    border-top: 1px solid var(--faixa-linha);
    font-size: var(--t-sm);
  }

  .rodape__topo {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 24px 48px;
    align-items: center;
    padding-bottom: 40px;
    border-bottom: 1px solid var(--linha);
  }

  .rodape__marca {
    color: var(--tinta);
  }

  .rodape__marca :global(.rodape__logo) {
    width: 150px;
    height: auto;
  }

  .rodape__posicionamento {
    max-width: 62ch;
    justify-self: end;
    color: var(--tinta-media);
    font-size: var(--t-base);
    line-height: 1.5;
  }

  .rodape__colunas {
    display: grid;
    grid-template-columns: 0.8fr 1.4fr 1.3fr 1.5fr;
    gap: 32px 40px;
    padding-block: 40px;
  }

  .rodape__colunas h2 {
    margin-bottom: 14px;
    color: #ffffff;
    font-size: var(--t-rotulo);
    letter-spacing: 0.08em;
  }

  .rodape__colunas ul {
    display: grid;
    gap: 4px;
    margin: 0;
  }

  .rodape__colunas a {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    min-height: 32px;
    color: var(--tinta-media);
    text-decoration: none;
  }

  .rodape__colunas a:hover {
    color: var(--tinta);
    text-decoration: underline;
  }

  .rodape__canais :global(svg) {
    flex: none;
    width: 18px;
    height: 18px;
    color: var(--acento);
  }

  .rodape__nota p {
    color: var(--tinta-media);
    line-height: 1.55;
  }

  .rodape__base {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 8px 24px;
    padding-top: 24px;
    border-top: 1px solid var(--linha);
    color: var(--tinta-fraca);
  }

  @media (max-width: 960px) {
    .rodape__topo {
      grid-template-columns: 1fr;
    }

    .rodape__posicionamento {
      justify-self: start;
    }

    .rodape__colunas {
      grid-template-columns: 1fr 1fr;
    }
  }

  @media (max-width: 560px) {
    .rodape__colunas {
      grid-template-columns: 1fr;
    }

    .rodape__colunas a {
      min-height: 44px;
    }

    /* Links curtos do mapa em duas colunas: a lista ocupa metade da altura. */
    .rodape__mapa ul {
      grid-template-columns: 1fr 1fr;
      column-gap: 16px;
    }

    .rodape__topo {
      padding-bottom: 28px;
    }

    .rodape__colunas {
      gap: 28px;
      padding-block: 28px;
    }
  }
</style>
