---
/** Conjunto mínimo de ícones em traço, desenhados para o site (sem biblioteca externa). */
const icones = {
  seta: '<path d="M5 12h14"/><path d="m13 6 6 6-6 6"/>',
  menu: '<path d="M4 7h16"/><path d="M4 12h16"/><path d="M4 17h16"/>',
  fechar: '<path d="m6 6 12 12"/><path d="M18 6 6 18"/>',
  'seta-esquerda': '<path d="M19 12H5"/><path d="m11 6-6 6 6 6"/>',
  email: '<rect x="3" y="5" width="18" height="14" rx="2"/><path d="m3.5 7 8.5 6 8.5-6"/>',
  check: '<path d="m5 12.5 4.5 4.5L19 7.5"/>',
  trava: '<rect x="5" y="10.5" width="14" height="10" rx="2"/><path d="M8.5 10.5V7.5a3.5 3.5 0 0 1 7 0v3"/>',
