    '<ellipse cx="12" cy="5.5" rx="7.5" ry="2.75"/><path d="M4.5 5.5v13c0 1.5 3.4 2.75 7.5 2.75s7.5-1.25 7.5-2.75v-13"/><path d="M4.5 12c0 1.5 3.4 2.75 7.5 2.75s7.5-1.25 7.5-2.75"/>',
  governanca:
    '<path d="M12 3 19.5 6v5.5c0 4.4-3.1 8.1-7.5 9.5-4.4-1.4-7.5-5.1-7.5-9.5V6L12 3Z"/><path d="m8.75 12 2.25 2.25 4.25-4.5"/>',
  pessoas:
    '<circle cx="9" cy="8" r="3.25"/><path d="M3 19.5c.6-3.3 3-5.25 6-5.25s5.4 1.95 6 5.25"/><path d="M15.5 4.9a3.25 3.25 0 0 1 0 6.2"/><path d="M17.5 14.6c1.9.6 3.1 2.4 3.5 4.9"/>',
  servidor:
    '<rect x="3.5" y="4" width="17" height="7" rx="1.5"/><rect x="3.5" y="13" width="17" height="7" rx="1.5"/><path d="M7.5 7.5h.01M7.5 16.5h.01M11 7.5h6M11 16.5h6"/>',
  planejamento:
    '<rect x="3.5" y="4.5" width="17" height="16" rx="2"/><path d="M3.5 9.5h17"/><path d="M8 2.75v3.5M16 2.75v3.5"/><path d="M7.5 13.5h3M13.5 13.5h3M7.5 17h3"/>',
} as const;

/**
 * Logos de terceiros, preenchidas e com o desenho original. A margem do viewBox faz a logo
 * ocupar a mesma área dos ícones em traço (cerca de 78 por cento da caixa), então o tamanho
 * e a cor (currentColor) definidos para cada ícone continuam valendo.
 */
const logos = {
  whatsapp: {
    viewBox: '-91.7 -90.2 819.7 819.7',
    d: 'M543.61,92.92C483.79,33.03,404.24.04,319.49,0,144.85,0,2.73,142.12,2.66,316.8c-.02,55.84,14.56,110.35,42.29,158.4L0,639.38l167.96-44.06c46.28,25.24,98.38,38.55,151.4,38.56h.13c174.61,0,316.76-142.13,316.82-316.82.04-84.66-32.89-164.26-92.71-224.14ZM319.49,580.37h-.11c-47.25-.02-93.59-12.72-134.03-36.71l-9.61-5.71-99.67,26.15,26.6-97.17-6.26-9.96c-26.36-41.93-40.28-90.39-40.26-140.14.05-145.19,118.19-263.31,263.44-263.31,70.34.02,136.46,27.45,186.17,77.23,49.72,49.78,77.08,115.94,77.06,186.3-.06,145.2-118.19,263.34-263.34,263.34ZM463.93,383.15c-7.91-3.96-46.84-23.11-54.1-25.76-7.25-2.64-12.53-3.96-17.81,3.96-5.28,7.92-20.45,25.76-25.07,31.04-4.62,5.28-9.23,5.95-17.15,1.98-7.92-3.96-33.42-12.32-63.66-39.29-23.53-20.99-39.42-46.92-44.04-54.84-4.61-7.93-.04-11.8,3.47-16.16,8.57-10.64,17.15-21.8,19.79-27.08,2.64-5.28,1.32-9.91-.66-13.87-1.97-3.96-17.81-42.93-24.4-58.78-6.43-15.43-12.95-13.35-17.81-13.59-4.61-.23-9.89-.28-15.17-.28s-13.85,1.98-21.11,9.91c-7.25,7.93-27.7,27.08-27.7,66.04s28.37,76.61,32.32,81.89,55.82,85.24,135.23,119.53c18.89,8.16,33.63,13.03,45.13,16.68,18.97,6.03,36.22,5.17,49.86,3.14,15.21-2.28,46.83-19.15,53.44-37.64,6.6-18.49,6.6-34.34,4.61-37.65-1.97-3.3-7.25-5.28-15.17-9.24Z',
  },
} as const;

export type NomeIcone = keyof typeof icones | keyof typeof logos;

interface Props {
  nome: NomeIcone;
  class?: string;
}

const { nome, class: classe } = Astro.props;
const logo = nome in logos ? logos[nome as keyof typeof logos] : undefined;
---

{
  logo ? (
    <svg class={classe} viewBox={logo.viewBox} fill="currentColor" aria-hidden="true" focusable="false">
      <path fill-rule="evenodd" d={logo.d} />
    </svg>
  ) : (
    <svg
      class={classe}
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="1.75"
      stroke-linecap="round"
      stroke-linejoin="round"
      aria-hidden="true"
      focusable="false"
      set:html={icones[nome as keyof typeof icones]}
    />
  )
}
