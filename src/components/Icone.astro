---
/** Conjunto mínimo de ícones em traço, desenhados para o site (sem biblioteca externa). */
const icones = {
  seta: '<path d="M5 12h14"/><path d="m13 6 6 6-6 6"/>',
  'seta-esquerda': '<path d="M19 12H5"/><path d="m11 6-6 6 6 6"/>',
  email: '<rect x="3" y="5" width="18" height="14" rx="2"/><path d="m3.5 7 8.5 6 8.5-6"/>',
  conversa:
    '<path d="M20.5 11.5a8.5 8.5 0 0 1-12.4 7.6L3.5 20.5l1.4-4.3a8.5 8.5 0 1 1 15.6-4.7Z"/><path d="M8.5 11.5h.01M12 11.5h.01M15.5 11.5h.01"/>',
  check: '<path d="m5 12.5 4.5 4.5L19 7.5"/>',
  trava: '<rect x="5" y="10.5" width="14" height="10" rx="2"/><path d="M8.5 10.5V7.5a3.5 3.5 0 0 1 7 0v3"/>',
  info: '<circle cx="12" cy="12" r="9"/><path d="M12 11v5.5"/><path d="M12 7.75h.01"/>',
  ia: '<path d="M12 3.5 13.9 9 19.5 11l-5.6 2L12 18.5 10.1 13 4.5 11l5.6-2L12 3.5Z"/><path d="M19 3.5v3M17.5 5h3"/>',
  camadas: '<path d="m12 3.5 8.5 4.5-8.5 4.5L3.5 8 12 3.5Z"/><path d="m3.5 12 8.5 4.5 8.5-4.5"/><path d="m3.5 16 8.5 4.5 8.5-4.5"/>',
  automacao:
    '<path d="M4.5 11a7.5 7.5 0 0 1 13.1-4.4L19.5 8.5"/><path d="M19.5 4v4.5H15"/><path d="M19.5 13a7.5 7.5 0 0 1-13.1 4.4L4.5 15.5"/><path d="M4.5 20v-4.5H9"/>',
  visao: '<path d="M2.5 12S6 5.5 12 5.5 21.5 12 21.5 12 18 18.5 12 18.5 2.5 12 2.5 12Z"/><circle cx="12" cy="12" r="3"/>',
  dados:
    '<ellipse cx="12" cy="5.5" rx="7.5" ry="2.75"/><path d="M4.5 5.5v13c0 1.5 3.4 2.75 7.5 2.75s7.5-1.25 7.5-2.75v-13"/><path d="M4.5 12c0 1.5 3.4 2.75 7.5 2.75s7.5-1.25 7.5-2.75"/>',
  governanca:
    '<path d="M12 3 19.5 6v5.5c0 4.4-3.1 8.1-7.5 9.5-4.4-1.4-7.5-5.1-7.5-9.5V6L12 3Z"/><path d="m8.75 12 2.25 2.25 4.25-4.5"/>',
  planejamento:
    '<rect x="3.5" y="4.5" width="17" height="16" rx="2"/><path d="M3.5 9.5h17"/><path d="M8 2.75v3.5M16 2.75v3.5"/><path d="M7.5 13.5h3M13.5 13.5h3M7.5 17h3"/>',
} as const;

export type NomeIcone = keyof typeof icones;

interface Props {
  nome: NomeIcone;
  class?: string;
}

const { nome, class: classe } = Astro.props;
---

<svg
  class={classe}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.75"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
  set:html={icones[nome]}
/>
