---
import SecaoTitulo from './SecaoTitulo.astro';

interface Props {
  principios: { titulo: string; texto: string }[];
  numero?: number;
}

const { principios, numero } = Astro.props;
---

<section class="secao secao--superficie" aria-labelledby="titulo-principios">
  <div class="container">
    <SecaoTitulo
      id="titulo-principios"
      numero={numero}
      rotulo="Engenharia"
      titulo="Princípios que governaram as decisões"
    />
    <ul class="principios" role="list">
      {
        principios.map((p, i) => (
          <li class="principio">
            <span class="principio__numero numeral" aria-hidden="true">
              P{i + 1}
            </span>
            <h3>{p.titulo}</h3>
            <p>{p.texto}</p>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .principios {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 300px), 1fr));
    gap: 16px;
    margin: 0;
  }

  .principio {
    position: relative;
    display: grid;
    align-content: start;
    gap: 8px;
    padding: 24px;
    border: 1px solid var(--linha);
    border-radius: var(--raio-2);
    background: var(--fundo);
  }

  /* Canto triangular: o mesmo detalhe dos cantos do logo. */
  .principio::after {
    content: '';
    position: absolute;
    left: -1px;
    bottom: -1px;
    width: 14px;
    height: 14px;
    border-bottom-left-radius: var(--raio-2);
    background: linear-gradient(45deg, var(--acento) 50%, transparent 50%);
  }

  .principio__numero {
    color: var(--tinta-fraca);
    font-size: var(--t-sm);
  }

  .principio p {
    color: var(--tinta-media);
  }
</style>
