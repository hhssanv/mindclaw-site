---
/**
 * Painel executivo de exemplo, recriado a partir do modelo de demonstração da
 * empresa fictícia Norvexa Systems (planilha com 12 páginas e 9 tabelas de origem).
 * Gráfico em SVG gerado no build, com tooltip por mês, foco por teclado e tabela.
 */
import Icone from './Icone.astro';
import { norvexa as n } from '../data/norvexa';
import { formato } from '../lib/formato';
import { LARGURAS } from '../lib/grafico';
import { textos, type Idioma } from '../i18n';

interface Props {
  idioma: Idioma;
}

const { idioma } = Astro.props;
const t = textos[idioma].painel;
const { moedaMi, milhoes, moeda, pct, pctFino, variacao, mesCurto, mesLongo, mesEAno } = formato(idioma);

type Estado = 'ok' | 'atencao' | 'alerta';
const k = n.kpis;

// ---------- Gráfico de linhas: realizado, previsão e orçamento ----------
const serie = n.serie;
const yMin = 1_150_000;
const yMax = 1_700_000;
const ticks = [1_200_000, 1_400_000, 1_600_000];
const iUltimoReal = serie.findLastIndex((p) => p.realizado !== null);
const meses = serie.map((_, i) => mesCurto(i, n.ano));

const kpis = [
  {
    rotulo: t.receitaMes,
    valor: moedaMi(k.receitaMes),
    nota: t.sobre(variacao(k.receitaMesVar), t.mesAno(meses[iUltimoReal], n.ano - 1)),
    estado: 'ok' as Estado,
  },
  { rotulo: t.arr, valor: moedaMi(k.arr), nota: t.em12Meses(variacao(k.arrVar)), estado: 'ok' as Estado },
  { rotulo: t.margemBruta, valor: pct(k.margemBruta), nota: t.meta(pct(k.margemBrutaMeta)), estado: 'atencao' as Estado },
  { rotulo: t.churn3Meses, valor: pctFino(k.churn), nota: t.teto(pctFino(k.churnTeto)), estado: 'alerta' as Estado },
];

const atencao = [
  { indicador: t.margemEbitda, atual: pct(k.margemEbitda), alvo: t.meta(pct(k.margemEbitdaMeta)), estado: 'alerta' as Estado },
  { indicador: t.churn, atual: pctFino(k.churn), alvo: t.teto(pctFino(k.churnTeto)), estado: 'alerta' as Estado },
  { indicador: t.taxaGanho, atual: pct(k.winRate), alvo: t.meta(pct(k.winRateMeta)), estado: 'alerta' as Estado },
  { indicador: t.margemBruta, atual: pct(k.margemBruta), alvo: t.meta(pct(k.margemBrutaMeta)), estado: 'atencao' as Estado },
  { indicador: t.crescimentoAno, atual: pct(k.crescimentoYtd), alvo: t.meta(pct(k.crescimentoMeta)), estado: 'ok' as Estado },
];

function montar(W: number) {
  // Rótulos diretos no fim das linhas só a partir de 600: abaixo disso a legenda basta.
  const rotulos = W >= 600;
  const H = { 240: 210, 320: 230, 440: 260, 600: 280, 820: 320, 1100: 380 }[W] ?? Math.round(W * 0.45);
  const m = { t: 24, r: rotulos ? 150 : 16, b: 32, l: W >= 820 ? 58 : 52 };
  const x = (i: number) => m.l + (i * (W - m.l - m.r)) / (serie.length - 1);
  const y = (v: number) => m.t + ((yMax - v) / (yMax - yMin)) * (H - m.t - m.b);
  const caminho = (pts: [number, number][]) => pts.map(([px, py], i) => `${i ? 'L' : 'M'}${px.toFixed(1)},${py.toFixed(1)}`).join('');
  const real = serie.flatMap((p, i) => (p.realizado !== null ? [[x(i), y(p.realizado)] as [number, number]] : []));
  const prev = [
    [x(iUltimoReal), y(serie[iUltimoReal].realizado!)] as [number, number],
    ...serie.flatMap((p, i) => (p.previsao !== null ? [[x(i), y(p.previsao)] as [number, number]] : [])),
  ];
  const orc = serie.map((p, i) => [x(i), y(p.orcamento)] as [number, number]);
  const passo = (W - m.l - m.r) / (serie.length - 1);
  return {
    W,
    H,
    m,
    x,
    y,
    rotulos,
    // Rótulo de mês a cada 1, 2 ou 3 meses, conforme o espaço por mês.
    pularMeses: passo >= 34 ? 1 : passo >= 20 ? 2 : 3,
    real: caminho(real),
    prev: caminho(prev),
    orc: caminho(orc),
    fimReal: real[real.length - 1],
    fimPrev: prev[prev.length - 1],
    fimOrc: orc[orc.length - 1],
    passo,
  };
}

const variantes = LARGURAS.map(montar);

const dadosTooltip = JSON.stringify(
  serie.map((p, i) => ({
    mes: meses[i],
    linhas: [
      p.realizado !== null && ['realizado', t.realizado, moedaMi(p.realizado)],
      p.previsao !== null && ['previsao', t.previsao, moedaMi(p.previsao)],
      ['orcamento', t.orcamento, moedaMi(p.orcamento)],
    ].filter(Boolean),
  })),
);

const rotuloAria = (i: number) => {
  const p = serie[i];
  return t.pontoAria(
    meses[i],
    p.realizado !== null ? moedaMi(p.realizado) : null,
    p.previsao !== null ? moedaMi(p.previsao) : null,
    moedaMi(p.orcamento),
  );
};
const diferencaAnual = n.previsaoAnual / n.orcamentoAnual - 1;
const ultimo = serie.length - 1;
const ariaGrafico = t.graficoAria({
  ano: n.ano,
  real: t.intervalo(mesLongo(0, n.ano), mesLongo(iUltimoReal, n.ano)),
  prev: t.intervalo(mesLongo(iUltimoReal + 1, n.ano), mesLongo(ultimo, n.ano)),
  previsto: moedaMi(n.previsaoAnual),
  orcado: moedaMi(n.orcamentoAnual),
});
---

<figure class="painel" aria-labelledby="painel-titulo">
  <div class="painel__barra">
    <span class="painel__janela" aria-hidden="true"><i></i><i></i><i></i></span>
    <p id="painel-titulo" class="painel__titulo">
      <strong>{n.empresa}</strong> · {t.painelExecutivo} · {mesEAno(iUltimoReal, n.ano)}
    </p>
    <span class="painel__selo">{t.selo}</span>
  </div>

  <div class="painel__corpo">
    <dl class="painel__kpis">
      {
        kpis.map((kpi) => (
          <div class="kpi">
            <dt>{kpi.rotulo}</dt>
            <dd class="kpi__valor">{kpi.valor}</dd>
            <dd class="kpi__nota">
              <span class:list={['estado', `estado--${kpi.estado}`]}>{t.estados[kpi.estado]}</span>
              <span>{kpi.nota}</span>
            </dd>
          </div>
        ))
      }
    </dl>

    <div class="painel__grade">
      <div class="painel__bloco painel__grafico" data-grafico data-pontos={dadosTooltip}>
        <div class="painel__bloco-topo">
          <h3>{t.graficoTitulo(n.ano)}</h3>
          <ul class="legenda" role="list" aria-label={textos[idioma].geral.legenda}>
            <li><span class="chave chave--realizado" aria-hidden="true"></span>{t.realizado}</li>
            <li><span class="chave chave--previsao" aria-hidden="true"></span>{t.previsao}</li>
            <li><span class="chave chave--orcamento" aria-hidden="true"></span>{t.orcamento}</li>
          </ul>
        </div>

        <div class="graficos">
          {
            variantes.map((g) => (
              <div class="grafico" data-w={g.W}>
                <svg viewBox={`0 0 ${g.W} ${g.H}`} role="group" aria-label={ariaGrafico}>
                  <rect
                    class="grafico__previsao-fundo"
                    x={g.x(iUltimoReal)}
                    y={g.m.t}
                    width={g.x(serie.length - 1) - g.x(iUltimoReal) + g.passo / 2}
                    height={g.H - g.m.t - g.m.b}
                  />
                  <text aria-hidden="true" class="grafico__marca" x={g.x(iUltimoReal) + 6} y={g.m.t - 8}>{t.marcaPrevisao}</text>
                  {ticks.map((tick) => (
                    <g>
                      <line class="grafico__grade" x1={g.m.l} x2={g.W - g.m.r} y1={g.y(tick)} y2={g.y(tick)} />
                      <text aria-hidden="true" class="grafico__eixo" x={g.m.l - 8} y={g.y(tick) + 4} text-anchor="end">
                        {milhoes(tick, 1)}
                      </text>
                    </g>
                  ))}
                  {meses.map((mes, i) =>
                    i % g.pularMeses === 0 ? (
                      <text aria-hidden="true" class="grafico__eixo" x={g.x(i)} y={g.H - 8} text-anchor="middle">
                        {mes}
                      </text>
                    ) : null,
                  )}
                  <line class="grafico__cursor" x1="0" x2="0" y1={g.m.t} y2={g.H - g.m.b} data-cursor />
                  <path class="linha linha--orcamento" d={g.orc} />
                  <path class="linha linha--previsao" d={g.prev} />
                  <path class="linha linha--realizado" d={g.real} />
                  <circle class="ponto ponto--realizado" cx={g.fimReal[0]} cy={g.fimReal[1]} r="4.5" />
                  {g.rotulos && (
                    <>
                      <text aria-hidden="true" class="grafico__rotulo" x={g.fimOrc[0] + 10} y={g.fimOrc[1] + 4}>
                        {t.orcamento} {milhoes(serie[ultimo].orcamento)}
                      </text>
                      <text aria-hidden="true" class="grafico__rotulo" x={g.fimPrev[0] + 10} y={g.fimPrev[1] + 4}>
                        {t.previsao} {milhoes(serie[ultimo].previsao!)}
                      </text>
                    </>
                  )}
                  {serie.map((_, i) => (
                    <rect
                      class="grafico__zona"
                      x={g.x(i) - g.passo / 2}
                      y={g.m.t}
                      width={g.passo}
                      height={g.H - g.m.t - g.m.b}
                      data-i={i}
                      data-x={g.x(i)}
                      tabindex="0"
                      role="img"
                      aria-label={rotuloAria(i)}
                    />
                  ))}
                </svg>
              </div>
            ))
          }
        </div>
        <div class="tooltip" role="status" aria-live="polite" hidden data-tooltip></div>
        <p class="painel__resumo">
          {t.resumoAntes}<strong>{moedaMi(n.previsaoAnual)}</strong>{t.resumoDepois(moedaMi(n.orcamentoAnual), variacao(diferencaAnual))}
        </p>
      </div>

      <div class="painel__bloco painel__atencao">
        <div class="painel__bloco-topo">
          <h3>{t.atencaoTitulo}</h3>
        </div>
        <ul role="list">
          {
            atencao.map((a) => (
              <li>
                <span class="atencao__indicador">{a.indicador}</span>
                <span class="atencao__valores">
                  <strong>{a.atual}</strong> · {a.alvo}
                </span>
                <span class:list={['estado', `estado--${a.estado}`]}>{t.estados[a.estado]}</span>
              </li>
            ))
          }
        </ul>
      </div>
    </div>

    <p class="painel__rodape">
      <span class="painel__validacao">
        <Icone nome="check" />
        {t.checagens(n.checagens.passando, n.checagens.total)}
      </span>
      <span>{t.regras(n.regras.total, n.regras.noAlvo, n.regras.atencao, n.regras.acao)}</span>
    </p>
  </div>

  <details class="painel__tabela">
    <summary>{t.verTabela}</summary>
    <div class="painel__tabela-rolagem">
      <table>
        <thead>
          <tr>
            <th scope="col">{t.mes}</th>
            <th scope="col">{t.realizado}</th>
            <th scope="col">{t.previsao}</th>
            <th scope="col">{t.orcamento}</th>
          </tr>
        </thead>
        <tbody>
          {
            serie.map((p, i) => (
              <tr>
                <th scope="row">{meses[i]}</th>
                <td>{p.realizado !== null ? moeda(p.realizado) : '—'}</td>
                <td>{p.previsao !== null ? moeda(p.previsao) : '—'}</td>
                <td>{moeda(p.orcamento)}</td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>
  </details>

  <figcaption class="painel__legenda">
    {t.legendaFigura(n.empresa)}
  </figcaption>
</figure>

<script>
  // Tooltip com cursor vertical: acompanha o ponteiro ou o foco do teclado, mês a mês.
  for (const bloco of document.querySelectorAll<HTMLElement>('[data-grafico]')) {
    const pontos = JSON.parse(bloco.dataset.pontos ?? '[]') as { mes: string; linhas: [string, string, string][] }[];
    const tooltip = bloco.querySelector<HTMLElement>('[data-tooltip]');
    if (!tooltip) continue;

    const mostrar = (zona: SVGRectElement) => {
      const i = Number(zona.dataset.i);
      const svg = zona.ownerSVGElement!;
      const cursor = svg.querySelector<SVGLineElement>('[data-cursor]');
      const x = Number(zona.dataset.x);
      cursor?.setAttribute('x1', String(x));
      cursor?.setAttribute('x2', String(x));
      svg.classList.add('ativo');

      tooltip.replaceChildren();
      const titulo = document.createElement('p');
      titulo.className = 'tooltip__titulo';
      titulo.textContent = pontos[i].mes;
      tooltip.append(titulo);
      for (const [chave, nome, valor] of pontos[i].linhas) {
        const linha = document.createElement('p');
        const marca = document.createElement('span');
        marca.className = `chave chave--${chave}`;
        const forte = document.createElement('strong');
        forte.textContent = valor;
        const rotulo = document.createElement('span');
        rotulo.textContent = nome;
        linha.append(marca, forte, rotulo);
        tooltip.append(linha);
      }

      const caixaSvg = svg.getBoundingClientRect();
      const caixaBloco = bloco.getBoundingClientRect();
      const escala = caixaSvg.width / svg.viewBox.baseVal.width;
      const esquerda = caixaSvg.left - caixaBloco.left + x * escala;
      tooltip.hidden = false;
      const largura = tooltip.offsetWidth;
      const posicao = esquerda + 14 + largura > caixaBloco.width ? esquerda - 14 - largura : esquerda + 14;
      tooltip.style.left = `${Math.max(0, posicao)}px`;
      tooltip.style.top = `${caixaSvg.top - caixaBloco.top + 8}px`;
    };

    const esconder = (svg: SVGSVGElement) => {
      svg.classList.remove('ativo');
      tooltip.hidden = true;
    };

    for (const zona of bloco.querySelectorAll<SVGRectElement>('.grafico__zona')) {
      zona.addEventListener('pointerenter', () => mostrar(zona));
      zona.addEventListener('focus', () => mostrar(zona));
      zona.addEventListener('blur', () => esconder(zona.ownerSVGElement!));
    }
    for (const svg of bloco.querySelectorAll('svg')) {
      svg.addEventListener('pointerleave', () => esconder(svg));
    }
  }
</script>

<style>
  .painel {
    --serie-realizado: var(--grafico-vermelho);
    --serie-orcamento: var(--grafico-azul);
    margin: 0;
    border: 1px solid var(--linha);
    border-radius: var(--raio-3);
    background: var(--fundo);
    box-shadow: var(--sombra);
    overflow: hidden;
  }

  .painel__barra {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px 14px;
    padding: 12px 18px;
    border-bottom: 1px solid var(--linha);
    background: var(--superficie);
  }

  .painel__janela {
    display: flex;
    gap: 6px;
  }

  @media (max-width: 560px) {
    .painel__janela {
      display: none;
    }
  }

  .painel__janela i {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: var(--linha-forte);
  }

  .painel__titulo {
    flex: 1 1 18rem;
    min-width: 0;
    color: var(--tinta-media);
    font-size: var(--t-sm);
  }

  .painel__titulo strong {
    color: var(--tinta);
  }

  .painel__selo {
    padding: 3px 10px;
    border: 1px dashed var(--linha-forte);
    border-radius: 999px;
    color: var(--tinta-media);
    font-size: 0.8125rem;
    font-weight: 500;
  }

  .painel__corpo {
    display: grid;
    gap: 16px;
    padding: clamp(14px, 2vw, 22px);
  }

  /* KPIs */
  .painel__kpis {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 12px;
    margin: 0;
  }

  .kpi {
    display: grid;
    gap: 6px;
    padding: 14px 16px;
    border: 1px solid var(--linha);
    border-radius: var(--raio-2);
  }

  .kpi dt {
    color: var(--tinta-media);
    font-size: 0.8125rem;
    font-weight: 500;
  }

  .kpi dd {
    margin: 0;
  }

  .kpi__valor {
    font-family: var(--fonte-display);
    font-size: clamp(1.375rem, 1.1rem + 0.9vw, 1.75rem);
    font-weight: 700;
    line-height: 1.1;
  }

  .kpi__nota {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 6px;
    color: var(--tinta-media);
    font-size: 0.8125rem;
  }

  .kpi__nota .estado {
    padding: 1px 8px 1px 6px;
    font-size: 0.75rem;
  }

  @media (max-width: 860px) {
    .painel__kpis {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  /* Blocos */
  .painel__grade {
    display: grid;
    grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
    gap: 16px;
  }

  @media (max-width: 960px) {
    .painel__grade {
      grid-template-columns: 1fr;
    }
  }

  .painel__bloco {
    position: relative;
    min-width: 0;
    padding: 16px;
    border: 1px solid var(--linha);
    border-radius: var(--raio-2);
  }

  .painel__bloco-topo {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 6px 16px;
    margin-bottom: 10px;
  }

  .painel__bloco h3 {
    font-size: var(--t-base);
  }

  .legenda {
    display: flex;
    flex-wrap: wrap;
    gap: 4px 14px;
    margin: 0;
    color: var(--tinta-media);
    font-size: 0.8125rem;
  }

  .legenda li {
    display: inline-flex;
    align-items: center;
    gap: 6px;
  }

  .chave {
    display: inline-block;
    width: 16px;
    height: 0;
    border-top: 2px solid;
  }

  .chave--realizado {
    border-color: var(--serie-realizado);
  }

  .chave--previsao {
    border-top-style: dashed;
    border-color: var(--serie-realizado);
  }

  .chave--orcamento {
    border-color: var(--serie-orcamento);
  }

  /* Gráfico (a variante por largura vem de .graficos, em global.css) */
  .grafico__grade {
    stroke: var(--linha);
    stroke-width: 1;
  }

  .grafico__eixo {
    fill: var(--tinta-media);
    font-family: var(--fonte);
    font-size: 14px;
    font-variant-numeric: tabular-nums;
  }

  .grafico__rotulo {
    fill: var(--tinta-media);
    font-family: var(--fonte);
    font-size: 14px;
    font-weight: 600;
  }

  .grafico__marca {
    fill: var(--tinta-media);
    font-family: var(--fonte);
    font-size: 13px;
    font-weight: 500;
  }

  .grafico__previsao-fundo {
    fill: var(--superficie);
  }

  .linha {
    fill: none;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .linha--realizado {
    stroke: var(--serie-realizado);
  }

  .linha--previsao {
    stroke: var(--serie-realizado);
    stroke-dasharray: 5 5;
  }

  .linha--orcamento {
    stroke: var(--serie-orcamento);
  }

  .ponto--realizado {
    fill: var(--serie-realizado);
    stroke: var(--fundo);
    stroke-width: 2;
  }

  .grafico__cursor {
    stroke: var(--tinta-fraca);
    stroke-width: 1;
    opacity: 0;
  }

  svg.ativo .grafico__cursor {
    opacity: 1;
  }

  .grafico__zona {
    fill: transparent;
    cursor: crosshair;
    outline: none;
  }

  .grafico__zona:focus-visible {
    fill: color-mix(in srgb, var(--acento) 8%, transparent);
    stroke: var(--acento);
    stroke-width: 1.5;
  }

  .tooltip {
    position: absolute;
    z-index: 2;
    display: grid;
    gap: 4px;
    min-width: 150px;
    padding: 10px 12px;
    border: 1px solid var(--linha-forte);
    border-radius: var(--raio-1);
    background: var(--fundo);
    box-shadow: var(--sombra);
    font-size: 0.8125rem;
    pointer-events: none;
  }

  .tooltip[hidden] {
    display: none;
  }

  .tooltip :global(.tooltip__titulo) {
    color: var(--tinta-media);
    font-weight: 600;
    text-transform: capitalize;
  }

  .tooltip :global(p) {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .tooltip :global(strong) {
    color: var(--tinta);
    font-variant-numeric: tabular-nums;
  }

  .tooltip :global(span:last-child) {
    color: var(--tinta-media);
  }

  .tooltip :global(.chave) {
    flex: none;
  }

  .tooltip :global(.chave--realizado) {
    border-color: var(--serie-realizado);
  }

  .tooltip :global(.chave--previsao) {
    border-top-style: dashed;
    border-color: var(--serie-realizado);
  }

  .tooltip :global(.chave--orcamento) {
    border-color: var(--serie-orcamento);
  }

  .painel__resumo {
    margin-top: 8px;
    color: var(--tinta-media);
    font-size: var(--t-sm);
  }

  .painel__resumo strong {
    color: var(--tinta);
  }

  /* Atenção da gestão */
  .painel__atencao ul {
    display: grid;
    margin: 0;
  }

  .painel__atencao li {
