---
/**
 * Ilustração (dados fictícios): necessidade de pessoas por hora, vinda do forecast,
 * contra uma escala montada pela média do dia. Mostra o problema que capacity resolve:
 * o total de horas fecha, mas o pico fica descoberto e sobra gente nas pontas.
 */
import { LARGURAS } from '../lib/grafico';
import { textos, type Idioma } from '../i18n';

interface Props {
  idioma: Idioma;
}

const { idioma } = Astro.props;
const t = textos[idioma].capacidade;
const primeiraHora = 8;
const horas = Array.from({ length: 12 }, (_, i) => t.hora(primeiraHora + i));
const necessidade = [6, 9, 13, 15, 11, 10, 12, 14, 12, 9, 7, 5];
const escala = 10;
const yMax = 16;

const totalNecessidade = necessidade.reduce((a, b) => a + b, 0);
const horasDescobertas = necessidade.filter((v) => v > escala).length;
const pessoasFaltando = necessidade.reduce((a, v) => a + Math.max(0, v - escala), 0);
const pessoasSobrando = necessidade.reduce((a, v) => a + Math.max(0, escala - v), 0);

function montar(W: number) {
  const H = { 240: 210, 320: 230, 440: 250, 600: 270, 820: 300, 1100: 340 }[W] ?? Math.round(W * 0.35);
  const m = { t: 20, r: 10, b: 32, l: 32 };
  const faixa = (W - m.l - m.r) / horas.length;
  const larguraBarra = Math.min(Math.round(faixa * 0.58), 44);
  const x = (i: number) => m.l + faixa * i + faixa / 2;
  const y = (v: number) => m.t + ((yMax - v) / yMax) * (H - m.t - m.b);
  const base = y(0);
  const raio = 4;
  // Barra com ponta arredondada no topo e base reta.
  const barra = (cx: number, topo: number, fundo: number, w: number, arredonda: boolean) => {
    const x0 = cx - w / 2;
    const r = Math.min(raio, (fundo - topo) / 2, w / 2);
    if (!arredonda || r <= 0) return `M${x0},${fundo}V${topo}H${x0 + w}V${fundo}Z`;
    return `M${x0},${fundo}V${topo + r}Q${x0},${topo} ${x0 + r},${topo}H${x0 + w - r}Q${x0 + w},${topo} ${x0 + w},${topo + r}V${fundo}Z`;
  };
  const barras = necessidade.map((v, i) => {
    const coberto = Math.min(v, escala);
    const falta = Math.max(0, v - escala);
    const lacuna = 2; // espaço em cor de fundo entre a parte coberta e a falta
    return {
      i,
      coberta: barra(x(i), y(coberto), base, larguraBarra, falta === 0),
      falta: falta > 0 ? barra(x(i), y(v), y(escala) - lacuna, larguraBarra, true) : null,
      zona: { x: m.l + faixa * i, w: faixa },
    };
  });
  // Rótulo de hora a cada 1, 2 ou 3 horas, conforme o espaço por hora.
  const pularHoras = faixa >= 40 ? 1 : faixa >= 22 ? 2 : 3;
  return { W, H, m, x, y, base, barras, yEscala: y(escala), faixa, pularHoras };
}

const variantes = LARGURAS.map(montar);
const rotulo = (i: number) => t.horaAria(horas[i], necessidade[i], escala, t.situacao(necessidade[i] - escala));
---

<figure class="capacidade" aria-labelledby="capacidade-titulo">
  <div class="capacidade__topo">
    <div>
      <p class="eyebrow">{t.eyebrow}</p>
      <h3 id="capacidade-titulo">{t.titulo}</h3>
    </div>
    <ul class="legenda" role="list" aria-label={textos[idioma].geral.legenda}>
      <li><span class="chave chave--barra" aria-hidden="true"></span>{t.necessidade}</li>
      <li><span class="chave chave--falta" aria-hidden="true"></span>{t.falta}</li>
      <li><span class="chave chave--linha" aria-hidden="true"></span>{t.escalaMedia(escala)}</li>
    </ul>
  </div>

  <div class="graficos">
    {
      variantes.map((g) => (
        <div class="grafico" data-w={g.W}>
          <svg
            viewBox={`0 0 ${g.W} ${g.H}`}
            role="group"
            aria-label={t.graficoAria({
              inicio: t.horaFrase(primeiraHora),
              fim: t.horaFrase(primeiraHora + horas.length - 1),
              escala,
              descobertas: horasDescobertas,
            })}
          >
            {[0, 5, 10, 15].map((t) => (
              <g>
                <line class="grade" x1={g.m.l} x2={g.W - g.m.r} y1={g.y(t)} y2={g.y(t)} />
                <text aria-hidden="true" class="eixo" x={g.m.l - 8} y={g.y(t) + 4} text-anchor="end">
                  {t}
                </text>
              </g>
            ))}
            {g.barras.map((b) => (
              <g class="hora" tabindex="0" role="img" aria-label={rotulo(b.i)} data-dica={rotulo(b.i)}>
                <rect class="hora__zona" x={b.zona.x} y={g.m.t} width={b.zona.w} height={g.base - g.m.t} />
                <path class="barra" d={b.coberta} />
                {b.falta && <path class="falta" d={b.falta} />}
              </g>
            ))}
            <line class="escala" x1={g.m.l} x2={g.W - g.m.r} y1={g.yEscala} y2={g.yEscala} />
            {horas.map((h, i) =>
              i % g.pularHoras === 0 ? (
                <text aria-hidden="true" class="eixo" x={g.x(i)} y={g.H - 8} text-anchor="middle">
                  {h}
                </text>
              ) : null,
            )}
          </svg>
        </div>
      ))
    }
  </div>
  <p class="capacidade__dica" aria-live="polite" data-dica-saida>{t.dica}</p>

  <figcaption class="capacidade__leitura">
    {
      t.leitura({
        escalaTotal: escala * horas.length,
        necessidade: totalNecessidade,
        descobertas: horasDescobertas,
        faltam: pessoasFaltando,
        sobram: pessoasSobrando,
      })
    }
  </figcaption>

  <details class="capacidade__tabela">
    <summary>{t.verTabela}</summary>
    <table>
      <thead>
        <tr>
          <th scope="col">{t.colunas.hora}</th>
          <th scope="col">{t.colunas.necessidade}</th>
          <th scope="col">{t.colunas.escalados}</th>
          <th scope="col">{t.colunas.diferenca}</th>
        </tr>
      </thead>
      <tbody>
        {
          horas.map((h, i) => (
            <tr>
              <th scope="row">{h}</th>
              <td>{necessidade[i]}</td>
              <td>{escala}</td>
              <td>{escala - necessidade[i] > 0 ? `+${escala - necessidade[i]}` : escala - necessidade[i]}</td>
            </tr>
          ))
        }
      </tbody>
    </table>
  </details>
</figure>

<script>
  for (const figura of document.querySelectorAll<HTMLElement>('.capacidade')) {
    const saida = figura.querySelector<HTMLElement>('[data-dica-saida]');
    if (!saida) continue;
    const padrao = saida.textContent;
    for (const hora of figura.querySelectorAll<SVGGElement>('.hora')) {
      const mostrar = () => {
        figura.querySelectorAll('.hora.ativa').forEach((h) => h.classList.remove('ativa'));
        hora.classList.add('ativa');
        saida.textContent = hora.dataset.dica ?? '';
      };
      hora.addEventListener('pointerenter', mostrar);
      hora.addEventListener('focus', mostrar);
    }
    figura.addEventListener('pointerleave', () => {
      figura.querySelectorAll('.hora.ativa').forEach((h) => h.classList.remove('ativa'));
      saida.textContent = padrao;
    });
  }
</script>

<style>
  .capacidade {
    --serie-necessidade: var(--grafico-azul);
    --serie-falta: var(--grafico-falta);
    display: grid;
    gap: 12px;
    margin: 0;
    padding: clamp(16px, 2.4vw, 26px);
    border: 1px solid var(--linha);
    border-radius: var(--raio-3);
    background: var(--fundo);
  }

  .capacidade__topo {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: 10px 24px;
  }

  .capacidade__topo .eyebrow {
    margin-bottom: 4px;
  }

  .capacidade h3 {
    font-size: var(--t-md);
  }

  .legenda {
    display: flex;
    flex-wrap: wrap;
    gap: 4px 16px;
    margin: 0;
    color: var(--tinta-media);
    font-size: 0.8125rem;
  }

  .legenda li {
    display: inline-flex;
    align-items: center;
    gap: 6px;
  }

  .chave {
    display: inline-block;
    flex: none;
  }

  .chave--barra,
  .chave--falta {
    width: 10px;
    height: 10px;
    border-radius: 2px;
    background: var(--serie-necessidade);
  }

  .chave--falta {
    background: var(--serie-falta);
  }

  .chave--linha {
    width: 16px;
    height: 0;
    border-top: 2px solid var(--tinta);
  }

  .grade {
    stroke: var(--linha);
    stroke-width: 1;
  }

  .eixo {
    fill: var(--tinta-media);
    font-family: var(--fonte);
    font-size: 14px;
    font-variant-numeric: tabular-nums;
  }

  .barra {
    fill: var(--serie-necessidade);
  }

  .falta {
    fill: var(--serie-falta);
  }

  .escala {
    stroke: var(--tinta);
    stroke-width: 2;
    stroke-linecap: round;
  }

  .hora {
    cursor: default;
    outline: none;
  }

  .hora__zona {
    fill: transparent;
  }

  .hora.ativa .hora__zona,
  .hora:focus-visible .hora__zona {
    fill: color-mix(in srgb, var(--tinta) 6%, transparent);
  }

  .hora:focus-visible .hora__zona {
    stroke: var(--acento);
    stroke-width: 1.5;
  }

  .capacidade__dica {
    min-height: 1.5em;
    color: var(--tinta-media);
    font-size: 0.8125rem;
    font-weight: 500;
  }

  .capacidade__leitura {
    padding-top: 12px;
    border-top: 1px solid var(--linha);
    color: var(--tinta-media);
    font-size: var(--t-sm);
    line-height: 1.55;
  }

  .capacidade__tabela summary {
    color: var(--acento);
    font-size: var(--t-sm);
    font-weight: 600;
    cursor: pointer;
  }

  .capacidade__tabela table {
    width: 100%;
    margin-top: 10px;
    border-collapse: collapse;
    font-size: 0.8125rem;
    font-variant-numeric: tabular-nums;
  }

  .capacidade__tabela th,
  .capacidade__tabela td {
    padding: 6px 10px;
    border-bottom: 1px solid var(--linha);
    text-align: right;
  }

  .capacidade__tabela th:first-child {
    text-align: left;
  }

  .capacidade__tabela thead th {
    color: var(--tinta-media);
    font-weight: 600;
  }
</style>
