---
import SecaoTitulo from './SecaoTitulo.astro';
import type { Case } from '../lib/schema';

interface Props {
  problemas: Case['problemas'];
  construido: Case['construido'];
  numero?: number;
}

const { problemas, construido, numero } = Astro.props;
const colunas = [
  { chave: 'problema', rotulo: 'O que estava quebrando', itens: problemas },
  { chave: 'construido', rotulo: 'O que foi construído', itens: construido },
];
---

<section class="secao" aria-labelledby="titulo-diagnostico">
  <div class="container">
    <SecaoTitulo
      id="titulo-diagnostico"
      numero={numero}
      rotulo="Diagnóstico"
      titulo="O que estava quebrando e o que foi construído"
    />
    <div class="split">
      {
        colunas.map((coluna) => (
          <div class:list={['split__coluna', `split__coluna--${coluna.chave}`]}>
            <p class="split__rotulo eyebrow">{coluna.rotulo}</p>
            <ol class="split__lista" role="list" aria-label={coluna.rotulo}>
              {coluna.itens.map((item, i) => (
                <li class="split__item">
                  <span class="split__numero numeral" aria-hidden="true">
                    {String(i + 1).padStart(2, '0')}
                  </span>
                  <div>
                    <h3>{item.titulo}</h3>
                    <p>{item.texto}</p>
                  </div>
                </li>
              ))}
            </ol>
          </div>
        ))
      }
    </div>
  </div>
</section>

<style>
  .split {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    grid-template-rows: auto repeat(4, auto);
    column-gap: clamp(24px, 4vw, 56px);
  }

  .split__coluna {
    display: grid;
    grid-row: 1 / span 5;
    grid-template-rows: subgrid;
  }

  .split__rotulo {
    padding-bottom: 14px;
    border-bottom: 2px solid var(--linha-forte);
  }

  .split__coluna--construido .split__rotulo {
    border-bottom-color: var(--acento);
    color: var(--acento);
  }

  .split__lista {
    display: grid;
    grid-row: 2 / span 4;
    grid-template-rows: subgrid;
    margin: 0;
  }

  .split__item {
    display: grid;
    grid-template-columns: 2.25rem 1fr;
    gap: 4px;
    padding-block: 22px;
    border-bottom: 1px solid var(--linha);
  }

  .split__numero {
    padding-top: 2px;
    color: var(--tinta-fraca);
    font-size: var(--t-sm);
  }


  .split__item h3 {
    margin-bottom: 6px;
  }

  .split__item p {
    color: var(--tinta-media);
  }

  @media (max-width: 760px) {
    .split {
      grid-template-columns: 1fr;
      grid-template-rows: none;
      row-gap: 40px;
    }

    .split__coluna,
    .split__lista {
      display: block;
      grid-row: auto;
    }
  }
</style>
