---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import SecaoTitulo from '../components/SecaoTitulo.astro';
import CaseCard from '../components/CaseCard.astro';
import CTAContato from '../components/CTAContato.astro';
import Icone from '../components/Icone.astro';
import { casesEmDestaque, casesPublicados, hrefCase } from '../lib/cases';
import { jsonLdPessoa } from '../lib/jsonld';
import { site } from '../lib/site';

const destaques = await casesEmDestaque();
const publicados = await casesPublicados();
const porId = new Map(publicados.map((c) => [c.id, c]));

const competencias = (await getCollection('competencias'))
  .sort((a, b) => a.data.ordem - b.data.ordem)
  .map((comp) => ({
    ...comp.data,
    cases: comp.data.casesRelacionados.map((id) => porId.get(id)).filter((c) => c !== undefined),
  }));

const etapas = (await getCollection('trabalho')).map((e) => e.data).sort((a, b) => a.numero - b.numero);

const foraDoEscopo = [
  {
    titulo: 'Produto pronto ou licença de software',
    texto: 'Cada entrega é construída para o processo do cliente, não vendida de prateleira.',
  },
  {
    titulo: 'Teste de invasão ou auditoria de certificação',
    texto: 'Governança, revisão de acessos e documentação, sim. Pentest e certificação formal, não.',
  },
  {
    titulo: 'Automação que age sozinha onde o erro custa caro',
    texto: 'Ação externa com impacto real passa por aprovação humana, sempre.',
  },
  {
    titulo: 'Entrega sem documentação',
    texto: 'Um sistema que só funciona enquanto quem o construiu está por perto não é uma entrega.',
  },
];

const [principal, ...outros] = destaques;
const titulo = `${site.nome} · Automação, integração e IA aplicada`;
---

<Base title={titulo} description={site.descricao} jsonLd={[jsonLdPessoa(competencias.map((c) => c.nome))]}>
  <!-- 1. Hero -->
  <section class="hero-home" aria-labelledby="titulo-home">
    <div class="container hero-home__interno">
      <div class="hero-home__texto entrada">
        <p class="eyebrow eyebrow--traco">{site.pessoa} · Automação, integração e IA aplicada</p>
        <h1 id="titulo-home">
          Do trabalho manual à <span class="hero-home__destaque">operação automatizada e auditável.</span>
        </h1>
        <p class="lead hero-home__lead">
          Processos complexos, sistemas desconectados e trabalho manual transformados em automações, integrações e sistemas
          inteligentes, com aprovação humana onde importa e registro de tudo o que acontece.
        </p>
        <div class="hero-home__acao">
          <a class="botao" href="/cases/">
            Ver os cases
            <Icone nome="seta" />
          </a>
        </div>
      </div>
      <div class="hero-home__marca" aria-hidden="true">
        <picture>
          <source type="image/avif" srcset="/marca/isotipo-480.avif 480w, /marca/isotipo-960.avif 960w" sizes="340px" />
          <img
            src="/marca/isotipo-480.webp"
            srcset="/marca/isotipo-480.webp 480w, /marca/isotipo-960.webp 960w"
            sizes="340px"
            width="480"
            height="480"
            alt=""
            fetchpriority="high"
          />
        </picture>
      </div>
    </div>
  </section>

  <!-- 2. Cases em destaque -->
  <section class="secao secao--superficie" aria-labelledby="titulo-destaques">
    <div class="container">
      <div class="cabecalho-com-link">
        <SecaoTitulo
          id="titulo-destaques"
          rotulo="Cases"
          titulo="Trabalho verificável, do problema à prova"
          lead="Produção é sistema real em operação. Demonstração é modelo com dados sintéticos. Todo case diz qual dos dois ele é."
        />
        <a class="link-seta" href="/cases/">
          Todos os cases
          <Icone nome="seta" />
        </a>
      </div>
      <div class="destaques">
        {principal && <CaseCard case={principal} variante="destaque" largo />}
        {outros.map((c) => <CaseCard case={c} variante="destaque" />)}
      </div>
    </div>
  </section>

  <!-- 3. Competências -->
  <section class="secao" aria-labelledby="titulo-competencias">
    <div class="container">
      <SecaoTitulo
        id="titulo-competencias"
        rotulo="Competências"
        titulo="Áreas de atuação, cada uma ligada ao case que a comprova"
      />
      <ul class="competencias" role="list">
        {
          competencias.map((comp) => (
            <li class="competencia">
              <Icone nome={comp.icone} class="competencia__icone" />
              <h3>{comp.nome}</h3>
              <p>{comp.descricao}</p>
              {comp.cases.length > 0 ? (
                <ul class="competencia__cases" role="list" aria-label={`Cases de ${comp.nome}`}>
                  {comp.cases.map((c) => (
                    <li>
                      <a href={hrefCase(c.id)}>
                        <Icone nome="seta" />
                        <span>{c.data.titulo}</span>
                      </a>
                    </li>
                  ))}
                </ul>
              ) : (
                <p class="competencia__em-breve">Case em preparação</p>
              )}
            </li>
          ))
        }
        <li class="competencia competencia--contato">
          <h3>Não encontrou a sua área?</h3>
          <p>Os cases mostram o método, não o limite do que dá para fazer.</p>
          <a class="link-seta" href="/contato/">
            Conte o problema
            <Icone nome="seta" />
          </a>
        </li>
      </ul>
    </div>
  </section>

  <!-- 4. Modelo de trabalho -->
  <section class="secao secao--superficie" aria-labelledby="titulo-trabalho">
    <div class="container">
      <div class="cabecalho-com-link">
        <SecaoTitulo id="titulo-trabalho" rotulo="Como funciona" titulo="Modelo de trabalho em oito etapas" />
        <a class="link-seta" href="/sobre/#modelo-de-trabalho">
          Etapas em detalhe
          <Icone nome="seta" />
        </a>
      </div>
      <ol class="etapas-home" role="list">
        {
          etapas.map((e) => (
            <li>
              <span class="etapas-home__numero numeral" aria-hidden="true">
                {String(e.numero).padStart(2, '0')}
              </span>
              <h3>{e.nome}</h3>
              <p>{e.resumo}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <!-- 5. O que fica de fora -->
  <section class="secao" aria-labelledby="titulo-fora">
    <div class="container fora">
      <SecaoTitulo
        id="titulo-fora"
        rotulo="Limite de escopo"
        titulo="O que fica de fora"
        lead="Dizer o que não está incluído é parte do trabalho. Vale para cada case e vale para o site inteiro."
      />
      <ul class="fora__lista" role="list">
        {
          foraDoEscopo.map((item) => (
            <li>
              <h3>{item.titulo}</h3>
              <p>{item.texto}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- 6. Contato -->
  <CTAContato
    titulo="Tem um processo que depende de alguém copiando, conferindo ou lembrando?"
    texto="Conte o problema do jeito que ele aparece no dia a dia. A primeira conversa serve para entender se o trabalho faz sentido."
    rotuloBotao="Falar sobre um projeto"
  />
</Base>

<style>
  /* Hero */
  .hero-home {
    overflow: hidden;
    padding-block: clamp(56px, 8vw, 120px) clamp(56px, 7vw, 104px);
  }

  .hero-home__interno {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: center;
    gap: 40px clamp(32px, 6vw, 96px);
  }

  .hero-home__texto {
    display: grid;
    gap: 24px;
    max-width: 46rem;
  }

  .hero-home h1 {
    font-size: clamp(2.5rem, 1.6rem + 3.6vw, 4.25rem);
    line-height: 1.02;
    letter-spacing: -0.015em;
  }

  .hero-home__destaque {
    background: linear-gradient(90deg, #da0b29, #782747);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  @media (prefers-color-scheme: dark) {
    .hero-home__destaque {
      background-image: linear-gradient(90deg, #ff5468, #e0698a);
    }
  }

  .hero-home__lead {
    max-width: 56ch;
  }

  .hero-home__acao {
    margin-top: 4px;
  }

  .hero-home__marca {
    position: relative;
    width: clamp(220px, 25vw, 330px);
  }

  .hero-home__marca::before {
    content: '';
    position: absolute;
    inset: 8% 4% 2%;
    border-radius: 50%;
    background: radial-gradient(closest-side, color-mix(in srgb, var(--marca-vermelho) 12%, transparent), transparent);
  }

  .hero-home__marca img {
    position: relative;
    width: 100%;
  }

  @media (prefers-reduced-motion: no-preference) {
    .hero-home__marca {
      animation: entrada 900ms 160ms cubic-bezier(0.2, 0.7, 0.2, 1) both;
    }
  }

  @media (max-width: 860px) {
    .hero-home__interno {
      grid-template-columns: 1fr;
    }

    .hero-home__marca {
      display: none;
    }
  }

  /* Cabeçalho de seção com link à direita, alinhado à base do título */
  .cabecalho-com-link {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: 0 32px;
  }

  .cabecalho-com-link .link-seta {
    margin-bottom: var(--titulo-secao);
  }

  /* Destaques */
  .destaques {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 20px;
  }

  .destaques > :global(.card--largo) {
    grid-column: 1 / -1;
  }

  @media (max-width: 760px) {
    .destaques {
      grid-template-columns: 1fr;
    }
  }

  /* Competências: 7 áreas + 1 célula de contato = grade sempre completa */
  .competencias {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 0;
    margin: 0;
    border-top: 1px solid var(--linha);
    border-left: 1px solid var(--linha);
  }

  .competencia {
    display: grid;
    grid-template-rows: auto auto 1fr auto;
    gap: 10px;
    padding: 28px 24px;
    border-right: 1px solid var(--linha);
    border-bottom: 1px solid var(--linha);
  }

  .competencia :global(.competencia__icone) {
    width: 26px;
    height: 26px;
    margin-bottom: 8px;
    color: var(--tinta);
  }

  .competencia p {
    color: var(--tinta-media);
    font-size: var(--t-sm);
    line-height: 1.55;
  }

  .competencia__cases {
    display: grid;
    gap: 6px;
    margin: 8px 0 0;
    padding-top: 14px;
    border-top: 1px solid var(--linha);
    font-size: var(--t-sm);
  }

  .competencia__cases a {
    display: grid;
    grid-template-columns: 16px 1fr;
    gap: 8px;
    color: var(--acento);
    font-weight: 500;
    line-height: 1.4;
    text-decoration: none;
  }

  .competencia__cases a :global(svg) {
    width: 16px;
    height: 16px;
    margin-top: 2px;
  }

  .competencia__cases a:hover span {
    text-decoration: underline;
  }

  .competencia__em-breve {
    margin-top: 8px;
    padding-top: 14px;
    border-top: 1px solid var(--linha);
    color: var(--tinta-fraca) !important;
  }

  .competencia--contato {
    grid-template-rows: auto 1fr auto;
    align-content: start;
    background: var(--superficie);
  }

  .competencia--contato h3 {
    font-family: var(--fonte-display);
    font-size: var(--t-lg);
    font-weight: 700;
  }

  @media (max-width: 1080px) {
    .competencias {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 560px) {
    .competencias {
      grid-template-columns: 1fr;
    }
  }

  /* Etapas (versão condensada) */
  .etapas-home {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 0 24px;
    margin: 0;
  }

  .etapas-home li {
    display: grid;
    align-content: start;
    gap: 6px;
    padding: 20px 0 28px;
    border-top: 1px solid var(--linha-forte);
  }

  .etapas-home__numero {
    color: var(--tinta-fraca);
    font-size: var(--t-sm);
  }

  .etapas-home h3 {
    font-size: var(--t-md);
  }

  .etapas-home p {
    color: var(--tinta-media);
    font-size: var(--t-sm);
    line-height: 1.5;
  }

  @media (max-width: 900px) {
    .etapas-home {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 520px) {
    .etapas-home {
      grid-template-columns: 1fr;
    }
  }

  /* O que fica de fora */
  .fora {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    gap: 24px clamp(32px, 5vw, 72px);
    align-items: start;
  }

  .fora :global(.secao-titulo) {
    margin-bottom: 0;
  }

  .fora__lista {
    display: grid;
    margin: 0;
    border-top: 1px solid var(--linha-forte);
  }

  .fora__lista li {
    display: grid;
    grid-template-columns: 28px 1fr;
    gap: 4px 0;
    padding: 20px 0;
    border-bottom: 1px solid var(--linha);
  }

  .fora__lista li::before {
    content: '';
    grid-row: 1 / span 2;
    width: 12px;
    height: 2px;
    margin-top: 0.75em;
    background: var(--tinta-fraca);
  }

  .fora__lista p {
    color: var(--tinta-media);
  }

  @media (max-width: 860px) {
    .fora {
      grid-template-columns: 1fr;
    }
  }
</style>
