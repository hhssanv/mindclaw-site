---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import CaseCard from '../../components/CaseCard.astro';
import CTAContato from '../../components/CTAContato.astro';
import { casesPublicados } from '../../lib/cases';
import { site } from '../../lib/site';

const cases = await casesPublicados();
const ids = new Set(cases.map((c) => c.id));

// Filtro por área: só as áreas que têm pelo menos um case publicado.
const areas = (await getCollection('competencias'))
  .sort((a, b) => a.data.ordem - b.data.ordem)
  .map((comp) => ({
    id: comp.data.id,
    nome: comp.data.nome,
    cases: comp.data.casesRelacionados.filter((id) => ids.has(id)),
  }))
  .filter((a) => a.cases.length > 0);

const areasDoCase = (id: string) =>
  areas
    .filter((a) => a.cases.includes(id))
    .map((a) => a.id)
    .join(' ');

const producao = cases.filter((c) => c.data.tipo === 'producao').length;
const demonstracao = cases.length - producao;
const partes = [
  producao > 0 && `${producao} de produção, sistemas reais em operação`,
  demonstracao > 0 && `${demonstracao} de demonstração, com dados sintéticos`,
].filter(Boolean);
const resumoTipos = `${cases.length} ${cases.length === 1 ? 'case' : 'cases'}: ${partes.join(', e ')}.`;
---

<Base
  title={`Cases · ${site.nome}`}
  description="Cases de automação, integração, IA aplicada e dados: o problema, o limite de escopo, o método e uma prova, sem expor implementação nem cliente."
>
  <section class="cabecalho" aria-labelledby="titulo-cases">
    <div class="container entrada">
      <p class="eyebrow eyebrow--traco">Portfólio</p>
      <h1 id="titulo-cases">Cases</h1>
      <p class="lead">
        {resumoTipos} Cada um mostra o problema, o limite de escopo, o método e uma prova. Nunca a implementação, nunca o
        cliente.
      </p>
    </div>
  </section>

  <section class="secao lista" aria-label="Lista de cases">
    <div class="container">
      {
        areas.length > 1 && (
          <div class="filtro" role="group" aria-label="Filtrar cases por área" data-filtro hidden>
            <span class="eyebrow filtro__rotulo">Filtrar por área</span>
            <button type="button" class="filtro__botao" aria-pressed="true" data-area="">
              Todas
            </button>
            {areas.map((a) => (
              <button type="button" class="filtro__botao" aria-pressed="false" data-area={a.id}>
                {a.nome}
              </button>
            ))}
          </div>
        )
      }
      <p class="visualmente-oculto" aria-live="polite" data-filtro-status></p>

      <ul class="grade" role="list">
        {
          cases.map((c) => (
            <li data-areas={areasDoCase(c.id)}>
              <CaseCard case={c} nivel={2} />
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <CTAContato
    titulo="Nenhum case parece com o seu problema?"
    texto="Os cases mostram o método, não o limite do que dá para fazer. Conte o que está travando."
    rotuloBotao="Falar sobre um projeto"
  />
</Base>

<script>
  // Filtro: só esconde e mostra. Sem rota nova e sem estado em URL.
  const filtro = document.querySelector<HTMLElement>('[data-filtro]');
  const status = document.querySelector<HTMLElement>('[data-filtro-status]');
  const itens = [...document.querySelectorAll<HTMLElement>('[data-areas]')];

  if (filtro && status) {
    filtro.hidden = false;
    const botoes = [...filtro.querySelectorAll<HTMLButtonElement>('button[data-area]')];

    filtro.addEventListener('click', (evento) => {
      const botao = (evento.target as HTMLElement).closest<HTMLButtonElement>('button[data-area]');
      if (!botao) return;
      const area = botao.dataset.area ?? '';
      botoes.forEach((b) => b.setAttribute('aria-pressed', String(b === botao)));

      let visiveis = 0;
      for (const item of itens) {
        const mostra = !area || (item.dataset.areas ?? '').split(' ').includes(area);
        item.hidden = !mostra;
        if (mostra) visiveis++;
      }
      status.textContent = `${visiveis} ${visiveis === 1 ? 'case exibido' : 'cases exibidos'}`;
    });
  }
</script>

<style>
  .cabecalho {
    padding-block: clamp(48px, 6vw, 88px) 0;
  }

  .cabecalho .container {
    display: grid;
    gap: 16px;
  }

  .cabecalho .lead {
    max-width: 64ch;
  }

  .lista {
    padding-top: clamp(32px, 4vw, 48px);
  }

  .filtro {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px;
    margin-bottom: 28px;
  }

  .filtro[hidden] {
    display: none;
  }

  .filtro__rotulo {
    margin-right: 6px;
  }

  .filtro__botao {
    min-height: 40px;
    padding: 8px 16px;
    border: 1px solid var(--linha-forte);
    border-radius: 999px;
    background: var(--fundo);
    color: var(--tinta-media);
    font-size: var(--t-sm);
    font-weight: 500;
    cursor: pointer;
    transition: border-color var(--transicao), background-color var(--transicao), color var(--transicao);
  }

  .filtro__botao:hover {
    border-color: var(--tinta-fraca);
    color: var(--tinta);
  }

  .filtro__botao[aria-pressed='true'] {
    border-color: var(--tinta);
    background: var(--tinta);
    color: var(--fundo);
  }

  .grade {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 340px), 1fr));
    gap: 16px;
    margin: 0;
  }

  .grade > li {
    display: grid;
  }

  .grade > li[hidden] {
    display: none;
  }
</style>
