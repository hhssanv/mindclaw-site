---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Confidencialidade from '../components/Confidencialidade.astro';
import CTAContato from '../components/CTAContato.astro';
import Icone from '../components/Icone.astro';
import { casesPublicados, hrefCase } from '../lib/cases';
import { site } from '../lib/site';

const publicados = await casesPublicados();
const porId = new Map(publicados.map((c) => [c.id, c]));

const servicos = (await getCollection('servicos'))
  .map((s) => s.data)
  .sort((a, b) => a.ordem - b.ordem)
  .map((s) => ({ ...s, provas: s.cases.map((id) => porId.get(id)).filter((c) => c !== undefined) }));
---

<Base
  title={`Serviços · ${site.nome}`}
  description="Quatro formas de contratar, descritas pelo resultado: diagnóstico com escopo fechado, construção de automação, auditoria de ambiente e acompanhamento."
>
  <section class="cabecalho" aria-labelledby="titulo-servicos">
    <div class="container entrada">
      <p class="eyebrow eyebrow--traco">Como contratar</p>
      <h1 id="titulo-servicos">Serviços</h1>
      <p class="lead">
        Quatro formas de contratação, descritas pelo resultado. Não é tabela de preço: o valor depende do escopo, e o
        escopo é fechado por escrito antes de começar.
      </p>
    </div>
  </section>

  <section class="secao servicos" aria-label="Formas de contratação">
    <div class="container">
      <ol class="servicos__lista" role="list">
        {
          servicos.map((s) => (
            <li class="servico" id={s.id}>
              <div class="servico__cabeca">
                <span class="servico__numero numeral" aria-hidden="true">
                  {String(s.ordem).padStart(2, '0')}
                </span>
                <h2>{s.nome}</h2>
                <p class="servico__resultado">{s.resultado}</p>
              </div>
              <div class="servico__listas">
                <div>
                  <h3 class="eyebrow">O que entra</h3>
                  <ul role="list" class="servico__entra">
                    {s.entra.map((item) => (
                      <li>
                        <Icone nome="check" />
                        <span>{item}</span>
                      </li>
                    ))}
                  </ul>
                </div>
                <div>
                  <h3 class="eyebrow">O que não entra</h3>
                  <ul role="list" class="servico__nao-entra">
                    {s.naoEntra.map((item) => (
                      <li>{item}</li>
                    ))}
                  </ul>
                </div>
                {s.provas.length > 0 && (
                  <div class="servico__provas">
                    <h3 class="eyebrow">Comprovado em</h3>
                    <ul role="list">
                      {s.provas.map((c) => (
                        <li>
                          <a class="link-seta" href={hrefCase(c.id)}>
                            {c.data.titulo}
                            <Icone nome="seta" />
                          </a>
                        </li>
                      ))}
                    </ul>
                  </div>
                )}
              </div>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <Confidencialidade />

  <CTAContato
    titulo="Não sabe qual dos quatro é o seu caso?"
    texto="Quase sempre começa por um diagnóstico. Conte o problema e a gente define o formato junto."
    rotuloBotao="Falar sobre um projeto"
  />
</Base>

<style>
  .cabecalho {
    padding-block: clamp(48px, 6vw, 88px) 0;
  }

  .cabecalho .container {
    display: grid;
    gap: 16px;
  }

  .servicos {
    padding-top: clamp(32px, 4vw, 56px);
  }

  .servicos__lista {
    display: grid;
    margin: 0;
  }

  .servico {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    gap: 24px clamp(32px, 5vw, 72px);
    padding-block: clamp(32px, 4vw, 48px);
    border-top: 1px solid var(--linha);
    scroll-margin-top: 96px;
  }

  .servico:first-child {
    border-top-color: var(--tinta);
  }

  .servico__cabeca {
    display: grid;
    align-content: start;
    gap: 12px;
  }

  .servico__numero {
    color: var(--acento);
    font-size: var(--t-sm);
  }

  .servico h2 {
    font-size: var(--t-xl);
    max-width: 22ch;
  }

  .servico__resultado {
    color: var(--tinta-media);
    font-size: var(--t-md);
    line-height: 1.55;
  }

  .servico__listas {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 28px 32px;
    align-content: start;
  }

  .servico__listas h3 {
    margin-bottom: 12px;
    font-size: var(--t-rotulo);
    letter-spacing: 0.08em;
  }

  .servico__listas ul {
    display: grid;
    gap: 8px;
    margin: 0;
  }

  .servico__entra li {
    display: grid;
    grid-template-columns: 18px 1fr;
    gap: 10px;
    line-height: 1.45;
  }

  .servico__entra :global(svg) {
    width: 18px;
    height: 18px;
    margin-top: 2px;
    color: var(--tinta-fraca);
  }

  .servico__nao-entra li {
    position: relative;
    padding-left: 28px;
    color: var(--tinta-media);
    line-height: 1.45;
  }

  .servico__nao-entra li::before {
    content: '';
    position: absolute;
    left: 3px;
    top: 0.7em;
    width: 12px;
    height: 2px;
    background: var(--tinta-fraca);
  }

  .servico__provas {
    grid-column: 1 / -1;
    padding-top: 20px;
    border-top: 1px dashed var(--linha-forte);
  }

  .servico__provas ul {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 28px;
  }

  .servico__provas .link-seta {
    font-size: var(--t-sm);
  }

  @media (max-width: 960px) {
    .servico {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 560px) {
    .servico__listas {
      grid-template-columns: 1fr;
    }
  }
</style>
