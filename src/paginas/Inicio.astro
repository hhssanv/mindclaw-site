---
import Base from '../layouts/Base.astro';
import SecaoTitulo from '../components/SecaoTitulo.astro';
import SolucaoCard from '../components/SolucaoCard.astro';
import ProjetoCard from '../components/ProjetoCard.astro';
import CTAContato from '../components/CTAContato.astro';
import Icone from '../components/Icone.astro';
import { solucoes, projetos, principios, mapaAreas, validarConteudo } from '../lib/conteudo';
import { jsonLdPessoa } from '../lib/jsonld';
import { site } from '../lib/site';
import { alternativasDe, rota, textos, type Idioma } from '../i18n';

interface Props {
  idioma: Idioma;
}

const { idioma } = Astro.props;
const t = textos[idioma];
const p = t.inicio;

await validarConteudo();
const areas = await solucoes(idioma);
const rotulos = mapaAreas(idioma, areas);
const destaques = (await projetos(idioma)).filter((x) => x.data.destaque).slice(0, 3);
const lista = await principios(idioma);
---

<Base
  idioma={idioma}
  alternativas={alternativasDe('inicio')}
  title={p.titulo(site.nome)}
  description={t.site.descricao}
  jsonLd={[jsonLdPessoa(idioma, areas.map((a) => a.data.titulo))]}
>
  <!-- 1. Hero -->
  <section class="hero-home" aria-labelledby="titulo-home">
    <div class="container hero-home__interno">
      <div class="hero-home__texto entrada">
        <p class="eyebrow eyebrow--traco hero-home__eyebrow">
          <span><span class="hero-home__eyebrow-nome">{site.pessoa} · </span>{p.eyebrow}</span>
        </p>
        <h1 id="titulo-home">
          {p.h1Antes}<span class="hero-home__destaque">{p.h1Destaque}</span>
        </h1>
        <p class="lead hero-home__lead">{p.lead}</p>
        <div class="hero-home__acao">
          <a class="botao" href={rota(idioma, 'solucoes')}>
            {p.verSolucoes}
            <Icone nome="seta" />
          </a>
        </div>
        <a class="hero-home__credencial" href={rota(idioma, 'sobre')}>
          <picture>
            <source type="image/avif" srcset="/marca/hans-spiller-160.avif" />
            <img src="/marca/hans-spiller-160.webp" width="160" height="160" alt="" />
          </picture>
          <span class="hero-home__credencial-texto">
            <strong>{site.pessoa} · {t.site.trajetoria}</strong>
            <span>{t.site.areasResumo}</span>
          </span>
        </a>
      </div>
      <div class="hero-home__marca" aria-hidden="true">
        <picture>
          <source
            type="image/avif"
            srcset="/marca/isotipo-480.avif 480w, /marca/isotipo-960.avif 960w"
            sizes="(max-width: 860px) 128px, 460px"
          />
          <img
            src="/marca/isotipo-480.webp"
            srcset="/marca/isotipo-480.webp 480w, /marca/isotipo-960.webp 960w"
            sizes="(max-width: 860px) 128px, 460px"
            width="480"
            height="480"
            alt=""
            fetchpriority="high"
          />
        </picture>
      </div>
    </div>
  </section>

  <!-- 2. Soluções -->
  <section class="secao secao--superficie" aria-labelledby="titulo-solucoes">
    <div class="container">
      <div class="cabecalho-com-link">
        <SecaoTitulo id="titulo-solucoes" rotulo={p.solucoesRotulo} titulo={p.solucoesTitulo} lead={p.solucoesLead} />
        <a class="link-seta" href={rota(idioma, 'solucoes')}>
          {p.todasSolucoes}
          <Icone nome="seta" />
        </a>
      </div>
      <ul class="solucoes" role="list">
        {
          areas.map((s) => (
            <li>
              <SolucaoCard idioma={idioma} solucao={s} />
            </li>
          ))
        }
        <li class="solucoes__contato">
          <p class="solucoes__contato-titulo">{p.naoEncontrou}</p>
          <p>{p.naoEncontrouTexto}</p>
          <a class="link-seta" href={rota(idioma, 'contato')}>
            {p.conteProblema}
            <Icone nome="seta" />
          </a>
        </li>
      </ul>
    </div>
  </section>

  <!-- 3. Resultado: medido, não prometido -->
  <section class="secao" aria-labelledby="titulo-resultado">
    <div class="container resultado">
      <SecaoTitulo id="titulo-resultado" rotulo={p.resultadoRotulo} titulo={p.resultadoTitulo} />
      <div class="resultado__corpo">
        <p class="resultado__texto">{p.resultadoTexto}</p>
        <ol class="resultado__passos" role="list">
          {
            p.medicao.map((m, i) => (
              <li>
                <span class="numeral" aria-hidden="true">
                  {String(i + 1).padStart(2, '0')}
                </span>
                <div>
                  <h3>{m.titulo}</h3>
                  <p>{m.texto}</p>
                </div>
              </li>
            ))
          }
        </ol>
      </div>
    </div>
  </section>

  <!-- 4. Projetos em destaque -->
  <section class="secao secao--superficie" aria-labelledby="titulo-projetos">
    <div class="container">
      <div class="cabecalho-com-link">
        <SecaoTitulo id="titulo-projetos" rotulo={p.projetosRotulo} titulo={p.projetosTitulo} lead={p.projetosLead} />
        <a class="link-seta" href={rota(idioma, 'projetos')}>
          {p.todosProjetos}
          <Icone nome="seta" />
        </a>
      </div>
      <div class="destaques">
        {destaques.map((x) => <ProjetoCard idioma={idioma} projeto={x} areas={rotulos} compacto />)}
      </div>
    </div>
  </section>

  <!-- 5. Forma de trabalhar -->
  <section class="secao" aria-labelledby="titulo-forma">
    <div class="container">
      <div class="cabecalho-com-link">
        <SecaoTitulo id="titulo-forma" rotulo={p.formaRotulo} titulo={p.formaTitulo} />
        <a class="link-seta" href={`${rota(idioma, 'sobre')}#forma-de-trabalhar`}>
          {p.sobrePerfil}
          <Icone nome="seta" />
        </a>
      </div>
      <ol class="principios" role="list">
        {
          lista.map((x) => (
            <li>
              <span class="principios__numero numeral" aria-hidden="true">
                {String(x.numero).padStart(2, '0')}
              </span>
              <h3>{x.nome}</h3>
              <p>{x.descricao}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <!-- 6. Contato -->
  <CTAContato idioma={idioma} titulo={p.ctaTitulo} texto={p.ctaTexto} />
</Base>

<style>
  /* Hero */
  .hero-home {
    overflow: hidden;
    padding-block: clamp(56px, 8vw, 112px) clamp(56px, 7vw, 96px);
  }

  .hero-home__interno {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: center;
    gap: 40px clamp(32px, 6vw, 96px);
  }

  .hero-home__texto {
    display: grid;
    gap: 24px;
    max-width: 46rem;
  }

  .hero-home h1 {
    font-size: clamp(2.5rem, 1.6rem + 3.6vw, 4.25rem);
    line-height: 1.02;
    letter-spacing: -0.015em;
  }

  /* No claro, o degradê aparece pelo texto transparente; no escuro, o texto tem cor própria (tokens.css). */
  .hero-home__destaque {
    background: var(--destaque-texto);
    -webkit-background-clip: text;
    background-clip: text;
    color: var(--destaque-cor);
  }

  /* Rótulo acima do título: fonte do texto corrido (o peso do .eyebrow fica), com tracking maior. */
  .hero-home__eyebrow {
    font-family: var(--fonte);
    font-stretch: 100%;
    letter-spacing: 0.2em;
  }

  .hero-home__lead {
    max-width: 56ch;
  }

  .hero-home__acao {
    margin-top: 4px;
  }

  .hero-home__credencial {
    display: flex;
    align-items: center;
    gap: 16px;
    margin-top: 8px;
    padding-top: 20px;
    border-top: 1px solid var(--linha);
    color: var(--tinta-media);
    font-size: var(--t-sm);
    text-decoration: none;
  }

  .hero-home__credencial picture {
    flex: none;
  }

  .hero-home__credencial img {
    display: block;
    width: 56px;
    height: 56px;
    border-radius: 50%;
  }

  .hero-home__credencial-texto {
    display: grid;
    gap: 2px;
  }

  .hero-home__credencial strong {
    color: var(--tinta);
    font-family: var(--fonte);
    font-size: var(--t-md);
    font-weight: 700;
    line-height: 1.25;
  }

  .hero-home__credencial:hover strong {
    color: var(--acento);
  }

  /* O desenho do isotipo ocupa só metade da largura do arquivo: a escala aumenta a marca.
     A largura cresce com a tela só até o ponto em que o título continua em três linhas. */
  .hero-home__marca {
    position: relative;
    width: clamp(200px, 64vw - 452px, 380px);
  }

  .hero-home__marca::before {
    content: '';
    position: absolute;
    inset: 8% 4% 2%;
    border-radius: 50%;
    background: radial-gradient(closest-side, color-mix(in srgb, var(--marca-vermelho) 12%, transparent), transparent);
  }

  .hero-home__marca img {
    position: relative;
    width: 100%;
    transform: scale(1.2);
  }

  @media (prefers-reduced-motion: no-preference) {
    .hero-home__marca {
      animation: entrada 900ms 160ms cubic-bezier(0.2, 0.7, 0.2, 1) both;
    }
  }

  @media (max-width: 860px) {
    .hero-home__interno {
      grid-template-columns: 1fr;
    }

    /* Celular: a marca volta, pequena, acima do texto. */
    .hero-home__marca {
      order: -1;
      width: 128px;
      margin: -12px 0 12px -14px;
    }

    .hero-home__marca::before {
      inset: 12% 8% 6%;
    }

    .hero-home__marca img {
      transform: none;
    }

    .hero-home__interno {
      gap: 0;
    }
  }

  @media (max-width: 480px) {
    .hero-home__eyebrow-nome {
      display: none;
    }
  }

  /* Cabeçalho de seção com link à direita */
  .cabecalho-com-link {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: 0 32px;
  }

  .cabecalho-com-link .link-seta {
    margin-bottom: var(--titulo-secao);
  }

  /* Soluções: 7 áreas + 1 célula de contato = grade completa em 4, 2 ou 1 coluna */
  .solucoes {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 16px;
    margin: 0;
  }

  /* Subgrid: título, resumo e link ficam na mesma altura em todos os cards da linha. */
  .solucoes > li {
    display: grid;
    grid-row: span 4;
    grid-template-rows: subgrid;
    row-gap: 0;
  }

  .solucoes > li > :global(.sol) {
    grid-row: 1 / -1;
    grid-template-rows: subgrid;
  }

  .solucoes > .solucoes__contato {
    display: grid;
    grid-row: span 4;
    grid-template-rows: none;
    align-content: start;
    gap: 10px;
    padding: 26px 24px;
    border: 1px dashed var(--linha-forte);
    border-radius: var(--raio-3);
  }

  .solucoes__contato-titulo {
    font-family: var(--fonte-display);
    font-size: var(--t-lg);
    font-weight: 700;
    line-height: 1.2;
  }

  .solucoes__contato p:not(.solucoes__contato-titulo) {
    color: var(--tinta-media);
    font-size: var(--t-sm);
    line-height: 1.55;
  }

  .solucoes__contato .link-seta {
    margin-top: 6px;
    font-size: var(--t-sm);
  }

  @media (max-width: 1080px) {
    .solucoes {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  /* Celular: cada área vira uma linha compacta (ícone, título e resumo), o card inteiro é o link. */
  @media (max-width: 560px) {
    .solucoes {
      grid-template-columns: 1fr;
      gap: 10px;
    }

    .solucoes > li,
    .solucoes > .solucoes__contato {
      grid-row: auto;
      grid-template-rows: none;
    }

    .solucoes > li > :global(.sol) {
      grid-row: auto;
      grid-template-columns: 24px minmax(0, 1fr) 20px;
      grid-template-rows: none;
      align-items: start;
      gap: 4px 14px;
      padding: 18px 16px;
    }

    .solucoes > li > :global(.sol) :global(.sol__icone) {
      grid-row: span 2;
      width: 24px;
      height: 24px;
      margin: 2px 0 0;
    }

    .solucoes > li > :global(.sol) :global(.sol__titulo) {
      grid-column: 2;
      font-size: var(--t-md);
    }

    .solucoes > li > :global(.sol) :global(.sol__resumo) {
      grid-column: 2 / -1;
    }

    /* "Ver a solução" vira só a seta, à direita do título. */
    .solucoes > li > :global(.sol) :global(.sol__ver) {
      grid-column: 3;
      grid-row: 1;
      gap: 0;
      margin: 2px 0 0;
      font-size: 0;
    }

    .solucoes__contato {
      padding: 18px 16px;
    }
  }

  /* Resultado */
  .resultado {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    gap: 24px clamp(32px, 5vw, 72px);
    align-items: start;
  }

  .resultado :global(.secao-titulo) {
    margin-bottom: 0;
  }

  .resultado__corpo {
    display: grid;
    gap: 28px;
  }

  .resultado__texto {
    font-size: var(--t-lg);
    line-height: 1.6;
  }

  .resultado__passos {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 16px;
    margin: 0;
  }

  .resultado__passos li {
    display: grid;
    gap: 8px;
    padding-top: 16px;
    border-top: 2px solid var(--acento);
  }

  .resultado__passos .numeral {
    color: var(--tinta-fraca);
    font-size: var(--t-sm);
  }

  .resultado__passos h3 {
    margin-bottom: 4px;
    font-size: var(--t-base);
  }

  .resultado__passos p {
    color: var(--tinta-media);
    font-size: var(--t-sm);
    line-height: 1.5;
  }

  @media (max-width: 860px) {
    .resultado {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 600px) {
    .resultado__passos {
      grid-template-columns: 1fr;
      gap: 0;
    }

    /* Número ao lado do título, não acima: cada passo fica com metade da altura. */
    .resultado__passos li {
      grid-template-columns: 2.25rem 1fr;
      gap: 0;
      padding: 14px 0 16px;
    }

    .resultado__passos li + li {
      border-top-width: 1px;
      border-top-color: var(--linha-forte);
    }

    .resultado__passos .numeral {
      padding-top: 2px;
    }
  }

  /* Projetos em destaque */
  .destaques {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 16px;
  }

  /* Tablet e celular: carrossel com rolagem lateral; o próximo card aparece pela metade
     para mostrar que há mais. Sem JavaScript: é só uma área com rolagem horizontal. */
  @media (max-width: 1080px) {
    .destaques {
      grid-template-columns: none;
      grid-auto-columns: min(86%, 400px);
      grid-auto-flow: column;
      gap: 12px;
      margin-inline: calc(-1 * var(--gutter));
      padding: 4px var(--gutter) 12px;
      overflow-x: auto;
      overscroll-behavior-x: contain;
      scroll-snap-type: x mandatory;
      scroll-padding-inline: var(--gutter);
      scrollbar-width: thin;
    }

    .destaques > :global(*) {
      scroll-snap-align: start;
    }
  }

  /* Forma de trabalhar */
  .principios {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 0 24px;
    margin: 0;
  }

  .principios li {
    display: grid;
    align-content: start;
    gap: 6px;
    padding: 20px 0 28px;
    border-top: 1px solid var(--linha-forte);
  }

  .principios__numero {
    color: var(--tinta-fraca);
    font-size: var(--t-sm);
  }

  .principios h3 {
    font-size: var(--t-md);
  }

  .principios p {
    color: var(--tinta-media);
    font-size: var(--t-sm);
    line-height: 1.5;
  }

  @media (max-width: 900px) {
    .principios {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 520px) {
    .principios {
      grid-template-columns: 1fr;
    }

    /* Número ao lado do título e menos respiro: oito princípios em pouco mais de uma tela. */
    .principios li {
      grid-template-columns: 2.25rem 1fr;
      gap: 2px 0;
      padding: 14px 0 16px;
    }

    .principios__numero {
      grid-row: span 2;
      padding-top: 2px;
    }

    .principios h3,
    .principios p {
      grid-column: 2;
    }
  }
</style>
