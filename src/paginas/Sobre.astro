---
import Base from '../layouts/Base.astro';
import SecaoTitulo from '../components/SecaoTitulo.astro';
import Confidencialidade from '../components/Confidencialidade.astro';
import CTAContato from '../components/CTAContato.astro';
import Icone from '../components/Icone.astro';
import { solucoes, principios, stack } from '../lib/conteudo';
import { jsonLdPessoa } from '../lib/jsonld';
import { site } from '../lib/site';
import { alternativasDe, textos, type Idioma } from '../i18n';

interface Props {
  idioma: Idioma;
}

const { idioma } = Astro.props;
const t = textos[idioma];
const p = t.sobre;
const areasStack = await stack(idioma);
const lista = await principios(idioma);
const areas = (await solucoes(idioma)).map((s) => s.data.titulo);
---

<Base
  idioma={idioma}
  alternativas={alternativasDe('sobre')}
  title={p.titulo(site.nome)}
  description={p.descricao}
  jsonLd={[jsonLdPessoa(idioma, areas)]}
>
  <section class="perfil" aria-labelledby="titulo-sobre">
    <div class="container perfil__interno">
      <div class="perfil__texto entrada">
        <p class="eyebrow eyebrow--traco">{p.eyebrow}</p>
        <h1 id="titulo-sobre">{site.pessoa}</h1>
        <p class="perfil__cargo">
          {t.site.trajetoria}{site.localizacao && <span> · {site.localizacao}</span>}
        </p>
        <div class="prosa perfil__prosa">
          {p.bio.map((paragrafo) => <p>{paragrafo}</p>)}
        </div>
        {
          site.linkedin && (
            <a class="link-seta" href={site.linkedin} rel="me noopener">
              {p.linkedin}
              <Icone nome="seta" />
            </a>
          )
        }
      </div>
      <figure class="perfil__foto">
        <picture>
          <source
            type="image/avif"
            srcset="/marca/hans-spiller-retrato-480.avif 480w, /marca/hans-spiller-retrato-960.avif 960w"
            sizes="(max-width: 860px) 160px, 340px"
          />
          <img
            src="/marca/hans-spiller-retrato-480.webp"
            srcset="/marca/hans-spiller-retrato-480.webp 480w, /marca/hans-spiller-retrato-960.webp 960w"
            sizes="(max-width: 860px) 160px, 340px"
            width="480"
            height="640"
            fetchpriority="high"
            alt={p.fotoAlt}
          />
        </picture>
      </figure>
    </div>
  </section>

  <section class="secao secao--superficie" aria-labelledby="titulo-stack">
    <div class="container">
      <SecaoTitulo id="titulo-stack" rotulo={p.stackRotulo} titulo={p.stackTitulo} />
      <dl class="stack">
        {
          areasStack.map((area) => (
            <div class="stack__area">
              <dt>{area.area}</dt>
              {area.itens.map((item) => (
                <dd>{item}</dd>
              ))}
            </div>
          ))
        }
      </dl>
    </div>
  </section>

  <section class="secao" id="forma-de-trabalhar" aria-labelledby="titulo-forma">
    <div class="container">
      <SecaoTitulo id="titulo-forma" rotulo={p.formaRotulo} titulo={p.formaTitulo} lead={p.formaLead} />
      <ol class="forma" role="list">
        {
          lista.map((x) => (
            <li class="forma__item">
              <span class="forma__numero numeral" aria-hidden="true">
                {String(x.numero).padStart(2, '0')}
              </span>
              <h3>{x.nome}</h3>
              <p>{x.descricao}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <Confidencialidade idioma={idioma} />

  <CTAContato idioma={idioma} titulo={p.ctaTitulo} texto={p.ctaTexto} />
</Base>

<style>
  .perfil {
    padding-block: clamp(48px, 6vw, 96px);
  }

  .perfil__interno {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 40px clamp(40px, 6vw, 96px);
    align-items: center;
  }

  .perfil__texto {
    display: grid;
    gap: 18px;
  }

  .perfil__cargo {
    margin-top: -6px;
    color: var(--tinta);
    font-family: var(--fonte-display);
    font-size: var(--t-lg);
    font-weight: 600;
  }

  .perfil__prosa {
    margin-top: 8px;
    font-size: var(--t-md);
    line-height: 1.65;
  }

  /* Retrato 3:4; o arquivo já vem recortado nessa proporção. */
  .perfil__foto {
    width: clamp(220px, 26vw, 340px);
    margin: 0;
  }

  .perfil__foto img {
    aspect-ratio: 3 / 4;
    border-radius: var(--raio-3);
  }

  @media (max-width: 860px) {
    .perfil__interno {
      grid-template-columns: 1fr;
    }

    .perfil__foto {
      order: -1;
      width: 160px;
    }
  }

  .stack {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0;
    margin: 0;
    border-top: 1px solid var(--linha);
    border-left: 1px solid var(--linha);
    background: var(--fundo);
  }

  .stack__area {
    display: grid;
    align-content: start;
    gap: 6px;
    padding: 22px 24px;
    border-right: 1px solid var(--linha);
    border-bottom: 1px solid var(--linha);
  }

  .stack dt {
    margin-bottom: 8px;
    color: var(--acento);
    font-family: var(--fonte);
    font-size: var(--t-rotulo);
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .stack dd {
    margin: 0;
    color: var(--tinta-media);
    font-size: var(--t-sm);
    line-height: 1.45;
  }

  @media (max-width: 960px) {
    .stack {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 560px) {
    .stack {
      grid-template-columns: 1fr;
    }
  }

  .forma {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0 clamp(32px, 4vw, 56px);
    margin: 0;
  }

  .forma__item {
    display: grid;
    grid-template-columns: 3rem 1fr;
    grid-template-rows: auto auto;
    align-content: start;
    gap: 4px 0;
    padding-block: 22px;
    border-top: 1px solid var(--linha);
  }

  .forma__numero {
    grid-row: 1 / span 2;
    color: var(--acento);
    font-size: var(--t-sm);
    padding-top: 3px;
  }

  .forma__item p {
    color: var(--tinta-media);
  }

  @media (max-width: 760px) {
    .forma {
      grid-template-columns: 1fr;
    }
  }
</style>
